[Unit]
Description=Farpy Web Render Worker
After=network.target farpy-web-render-api.service
Requires=farpy-web-render-api.service

[Service]
Type=simple
WorkingDirectory=/opt/farpy-web-render
ExecStart=/usr/bin/env node /opt/farpy-web-render/scripts/render-worker.mjs
Environment=NODE_ENV=production
Environment=FARPY_WEB_RENDER_HOST=127.0.0.1
Environment=FARPY_WEB_RENDER_PORT=19102
Environment=FARPY_WEB_RENDER_DATA_DIR=/var/lib/farpy-web-render
Environment=BLENDER_EXE=/usr/local/bin/blender
Restart=always
RestartSec=5
StandardOutput=append:/var/log/farpy-web-render/worker.log
StandardError=append:/var/log/farpy-web-render/worker.err.log

[Install]
WantedBy=multi-user.target
