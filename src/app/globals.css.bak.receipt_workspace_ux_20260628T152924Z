@import "tailwindcss";

/* ============================================================
   Farpy Ã¢â‚¬â€ design tokens
   Built on the product's own duality: a LIGHT world (proof /
   finished / trustworthy) and a DARK world (compute / hardware /
   render-in-progress). Foundation cooled off the golden-cream
   tell to a neutral bone; the accent is the GPU glow ("render
   red"), spent only on action + the live render. Full tonal
   ladder so sections lift by value, not just shadow.
   ============================================================ */

:root {
  /* ---- Light world Ã¢â‚¬â€ "proof / finished" ---- */
  /* cool neutral, NOT cream: a faint blue-gray cast reads technical/studio, the
     render-red accent carries all the warmth the page needs */
  --paper:      #F1F2F4;  /* cool neutral foundation */
  --paper-2:    #E7E9EC;  /* faint step down Ã¢â‚¬â€ alt bands, hovers, recessed cards */
  --card:       #FBFCFD;  /* raised surfaces: LIGHTER than paper, so cards lift by value first */
  --well:       #E3E6EA;  /* recessed wells / dropzones / the render stage behind the donut */

  --ink:        #14161B;  /* cool viewport-black Ã¢â‚¬â€ headings */
  --ink-2:      #383B42;  /* body */
  --ink-3:      #64676F;  /* captions / secondary (AA on the cool foundation) */

  --line:       #E0E3E7;  /* hairline borders */
  --line-2:     #CDD1D7;  /* stronger hairline */

  /* ---- Accent Ã¢â‚¬â€ "render red", derived from the RTX/MSI hardware glow ---- */
  --accent:       #E5392B;  /* action + the live render ONLY */
  --accent-press: #B82216;  /* hover / active */
  --accent-tint:  #FBE7E3;  /* pale wash behind accent elements */
  --accent-ink:   #FFF6F4;  /* text on accent */

  /* ---- Verified Ã¢â‚¬â€ functional green, kept for receipts / proof ---- */
  --ok:         #1F8A52;
  --ok-tint:    #E1F1E8;

  /* ---- Dark world Ã¢â‚¬â€ "compute / viewport", same accent as a light source ---- */
  --void:       #0E0F12;
  --void-2:     #17181C;
  --on-void:    #EDEDEA;
  --glow:       #E5392B;

  /* ---- Elevation Ã¢â‚¬â€ tight + directional only. No omnidirectional blur (the #2 tell). ---- */
  --sh-sm: 0 1px 2px rgba(21, 22, 26, 0.05);
  --sh-md: 0 2px 4px rgba(21, 22, 26, 0.05), 0 8px 16px rgba(21, 22, 26, 0.05);
  --sh-lg: 0 4px 8px rgba(21, 22, 26, 0.06), 0 18px 34px rgba(21, 22, 26, 0.07);

  /* ---- Radius Ã¢â‚¬â€ tightened + varied with intent; data elements go sharp (0) ---- */
  --r-sm: 8px; --r-md: 12px; --r-lg: 14px; --r-xl: 18px; --r-pill: 999px;

  /* next/font supplies the variable family names; fallbacks hold layout before load. */
  --font-display: var(--font-clash), ui-sans-serif, system-ui, sans-serif;
  --font-sans: var(--font-hanken), ui-sans-serif, system-ui, sans-serif;
  --font-mono: var(--font-geist-mono), ui-monospace, SFMono-Regular, monospace;

  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}

/* Expose the same tokens to Tailwind so utilities (bg-paper, text-ink,
   rounded-xl, shadow-lg, font-display, Ã¢â‚¬Â¦) are available for future work. */
@theme inline {
  --color-paper: var(--paper);
  --color-paper-2: var(--paper-2);
  --color-card: var(--card);
  --color-well: var(--well);

  --color-ink: var(--ink);
  --color-ink-2: var(--ink-2);
  --color-ink-3: var(--ink-3);

  --color-line: var(--line);
  --color-line-2: var(--line-2);

  --color-accent: var(--accent);
  --color-accent-press: var(--accent-press);
  --color-accent-tint: var(--accent-tint);
  --color-accent-ink: var(--accent-ink);

  --color-ok: var(--ok);
  --color-ok-tint: var(--ok-tint);

  --color-void: var(--void);
  --color-void-2: var(--void-2);
  --color-on-void: var(--on-void);
  --color-glow: var(--glow);

  --radius-sm: var(--r-sm);
  --radius-md: var(--r-md);
  --radius-lg: var(--r-lg);
  --radius-xl: var(--r-xl);
  --radius-pill: var(--r-pill);

  --shadow-sm: var(--sh-sm);
  --shadow-md: var(--sh-md);
  --shadow-lg: var(--sh-lg);

  --font-display: var(--font-display);
  --font-sans: var(--font-sans);
  --font-mono: var(--font-mono);

  --ease-out: var(--ease-out);
}

/* ============================================================
   Base
   ============================================================ */
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
/* let height/block-size animate to and from `auto` (used by the FAQ reveal) */
@supports (interpolate-size: allow-keywords) {
  :root { interpolate-size: allow-keywords; }
}
body {
  margin: 0;
  font-family: var(--font-sans);
  color: var(--ink);
  background: var(--paper);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; cursor: pointer; }
img { display: block; max-width: 100%; }
code { font-family: var(--font-mono); font-size: 0.86em; background: var(--well); padding: 0.08em 0.34em; border-radius: 6px; color: var(--ink); }
.mono { font-family: var(--font-mono); font-feature-settings: "tnum" 1; }

.wrap { width: min(1480px, 100% - clamp(1.5rem, 4vw, 4rem)); margin-inline: auto; }

/* ---------- nav ---------- */
.nav {
  position: sticky; top: 0; z-index: 50;
  transition: background .3s ease, box-shadow .3s ease, border-color .3s ease;
  border-bottom: 1px solid transparent;
}
.nav.is-scrolled {
  background: rgba(241, 242, 244, 0.85);
  backdrop-filter: blur(12px) saturate(1.4);
  border-bottom-color: var(--line);
}
.nav-inner { display: flex; align-items: center; gap: 1.25rem; height: 72px; }
.brand { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-weight: 700; font-size: 1.34rem; letter-spacing: -0.02em; }
.nav-links { display: none; gap: 1.7rem; margin-inline: auto; }
.nav-links a { color: var(--ink-2); font-weight: 500; font-size: 0.95rem; position: relative; padding: 0.4rem 0; transition: color .2s ease; }
.nav-links a::after { content: ""; position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left center; transition: transform .28s var(--ease-out); }
.nav-links a:hover { color: var(--ink); }
.nav-links a:hover::after { transform: scaleX(1); }
.nav-cta { display: flex; align-items: center; gap: 0.45rem; margin-left: auto; }
@media (min-width: 760px) { .nav-links { display: flex; } .nav-cta { margin-left: 0; } }

/* ---------- buttons ---------- */
.btn {
  --pad-y: 0.72rem; --pad-x: 1.15rem;
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: var(--pad-y) var(--pad-x);
  border-radius: var(--r-sm);
  font-weight: 600; font-size: 0.96rem; line-height: 1;
  border: 1px solid transparent; white-space: nowrap;
  transition: transform .18s var(--ease-out), box-shadow .22s var(--ease-out), background .2s ease, border-color .2s ease, color .2s ease;
}
.btn svg { width: 1.05em; height: 1.05em; }
.btn-sm { --pad-y: 0.58rem; --pad-x: 0.98rem; font-size: 0.9rem; }
.btn-primary { background: var(--accent); color: var(--accent-ink); box-shadow: var(--sh-sm), inset 0 1px 0 oklch(1 0 0 / 0.18); }
.btn-primary:hover { background: var(--accent-press); transform: translateY(-1px); box-shadow: var(--sh-md), inset 0 1px 0 oklch(1 0 0 / 0.18); }
.btn-primary:active { transform: translateY(0); }
.btn-ghost { color: var(--ink-2); }
.btn-ghost:hover { color: var(--ink); background: var(--well); }
.btn-outline { background: var(--card); color: var(--ink); border-color: var(--line-2); }
.btn-outline:hover { border-color: var(--ink-3); transform: translateY(-1px); box-shadow: var(--sh-sm); }
.btn-oauth { background: var(--ink); color: var(--paper); }
.btn-oauth:hover { transform: translateY(-1px); box-shadow: var(--sh-md); }
.btn-block { width: 100%; }
.btn:disabled, .btn[aria-disabled="true"] { background: var(--well); color: var(--ink-3); border-color: var(--line); box-shadow: none; cursor: not-allowed; transform: none; }
.btn:focus-visible, a:focus-visible, .dropzone:focus-visible, .text-btn:focus-visible, .render-card a:focus-visible { outline: 2.5px solid var(--accent); outline-offset: 3px; border-radius: var(--r-sm); }
.text-btn { background: none; border: none; color: var(--ink-3); font-size: 0.86rem; font-weight: 500; padding: 0.35rem; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); transition: color .18s ease; }
.text-btn:hover { color: var(--ink); }
.link { color: var(--accent); font-weight: 600; }
.status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 3px var(--ok-tint); flex: none; }

/* ---------- hero Ã¢â‚¬â€ two-column: copy on light paper (left), the live donut on a
   dark studio stage that bleeds off the right edge. The donut gets its own column
   so it can be the hero at full size, with no funnel collision. ---------- */
.hero { position: relative; isolation: isolate; overflow: hidden; padding-top: clamp(1.75rem, 4vw, 3rem); padding-bottom: clamp(2.5rem, 5vw, 3.5rem); }
/* faint viewport grid develops on load Ã¢â‚¬â€ ambient structure behind both columns */
.hero::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background-image:
    linear-gradient(to right, oklch(0.50 0.005 255 / 0.14) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.50 0.005 255 / 0.14) 1px, transparent 1px);
  background-size: clamp(58px, 5vw, 86px) clamp(58px, 5vw, 86px);
  background-position: center top;
  -webkit-mask-image: radial-gradient(135% 98% at 38% 40%, transparent 18%, #000 64%);
  mask-image: radial-gradient(135% 98% at 38% 40%, transparent 18%, #000 64%);
  transform: translate3d(0, var(--hero-shift, 0px), 0);
  animation: gridDevelop 1.5s var(--ease-out) both;
}
/* wide + contained with EVEN gutters: more horizontal room so the headline
   breathes (fewer stacked lines) and the donut stage reads as a wide landscape */
.hero-grid { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); width: min(1480px, 100% - clamp(1.5rem, 4vw, 4rem)); margin-inline: auto; }
@media (min-width: 940px) {
  .hero-grid {
    align-items: center;
    grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
    column-gap: clamp(2rem, 3.5vw, 3.25rem);
  }
}
.hero-copy { display: flex; flex-direction: column; min-width: 0; }

/* the funnel sits in the copy column as a focused light card Ã¢â‚¬â€ it no longer
   competes with the dark donut stage for the eye */
.hero .widget { border-radius: var(--r-md); box-shadow: var(--sh-sm); border-color: var(--line); }
.hero .stage { min-height: clamp(226px, 28vh, 286px); }

/* the donut stage Ã¢â‚¬â€ a tall, immersive viewport flush to the right viewport edge */
.hero-stage { position: relative; min-width: 0; }

/* Ã¢â€â‚¬Ã¢â€â‚¬ one dark studio stage Ã¢â€â‚¬Ã¢â€â‚¬
   The canvas renders with alpha, so this backdrop IS the studio the donut sits in.
   Cool deep charcoal (brand void family) cyclorama Ã¢â‚¬â€ darker overhead, lifting at
   the horizon Ã¢â‚¬â€ with a soft WARM key pool upper-right behind the donut (so its
   warm studio lighting reads as motivated, warm-on-cool) and a flat contact
   ellipse below it. The donut rests ON a lit stage, not pasted onto a flat panel,
   and the deep cool value gives hard figure/ground against the paper copy column. */
.hero-stage .viewport {
  --vp-ink:   oklch(0.97 0.004 250);
  --vp-ink-2: oklch(0.84 0.012 60);
  --vp-ink-3: oklch(0.68 0.012 58);
  --vp-glass: oklch(0.30 0.016 250 / 0.55);
  --vp-line:  oklch(1 0 0 / 0.14);
  border-color: oklch(1 0 0 / 0.08);
  box-shadow: var(--sh-lg), inset 0 1px 0 oklch(1 0 0 / 0.07);
  background:
    /* soft-box: a clearly visible lit backdrop right behind the donut, so it sits
       in light instead of floating on a black void */
    radial-gradient(52% 58% at 58% 38%, oklch(0.42 0.013 258 / 0.9), transparent 72%),
    /* warm key spill upper-right, motivated by the donut's own warm key light */
    radial-gradient(30% 38% at 80% 26%, oklch(0.52 0.055 58 / 0.34), transparent 72%),
    /* floor grounding: a soft pool under the donut so it rests on a surface */
    radial-gradient(44% 20% at 55% 88%, oklch(0.32 0.012 258 / 0.55), transparent 78%),
    /* gentle edge vignette to settle the corners without going pure black */
    radial-gradient(135% 125% at 52% 36%, transparent 54%, oklch(0.14 0.008 260 / 0.5) 100%),
    /* base cyclorama: a lifted cool charcoal studio, NOT near-black */
    linear-gradient(180deg, oklch(0.235 0.011 262), oklch(0.288 0.012 259) 50%, oklch(0.225 0.01 257));
}
@media (max-width: 939px) {
  .hero-stage { margin-top: clamp(0.5rem, 2vw, 1rem); }
}
@media (min-width: 940px) {
  /* a wide landscape stage, all four corners rounded, centered against the copy
     column. Capped height keeps it horizontal (never the tall portrait look). */
  .hero-stage { align-self: center; height: clamp(400px, 48vh, 540px); display: flex; }
  .hero-stage .viewport { width: 100%; height: 100%; }
  .hero-stage .vp-stage { height: 100%; aspect-ratio: auto; }
}

/* HUD chrome reads light-on-dark over the studio backdrop (scoped to the hero
   stage; the How-it-works viewport stays on the light treatment) */
.hero-stage .vp-tabs { background: var(--vp-glass); border-color: var(--vp-line); box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.08); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.hero-stage .vp-tab { color: var(--vp-ink-3); }
.hero-stage .vp-tab:hover { color: var(--vp-ink-2); }
.hero-stage .vp-tab[aria-selected="true"] { color: var(--vp-ink); background: oklch(1 0 0 / 0.11); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.10); }
.hero-stage .vp-meta { color: var(--vp-ink-3); background: var(--vp-glass); border-color: var(--vp-line); box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.06); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.hero-stage .vp-stat { color: var(--vp-ink-2); }
.hero-stage .vp-stat-dot { background: var(--vp-ink-3); }
.hero-stage .vp-bar { background: oklch(1 0 0 / 0.10); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.12); }
.hero-stage .vp-hint { color: var(--vp-ink-2); background: var(--vp-glass); border-color: var(--vp-line); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }

.h1 {
  font-family: var(--font-display); font-weight: 700;
  font-size: clamp(2.55rem, 5.6vw, 4.1rem); line-height: 1.015; letter-spacing: -0.03em;
  /* compensate the tight tracking so display word-gaps don't collapse ("onrealGPUs") */
  word-spacing: 0.07em;
  margin: 0 0 1.3rem; color: var(--ink); text-wrap: balance;
}
.h1-accent { color: var(--accent); display: block; text-wrap: balance; }
.lede { font-size: clamp(1.05rem, 1.8vw, 1.2rem); color: var(--ink-2); max-width: 40ch; margin: 0 0 1.9rem; }

.assure { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.72rem; }
.assure li { display: flex; align-items: center; gap: 0.62rem; font-size: 0.98rem; color: var(--ink-2); }
.assure strong { color: var(--ink); font-weight: 600; }
.check-ico { width: 20px; height: 20px; flex: none; color: var(--ok); }

/* hero variant: a quiet wrapping trust line beneath the action, not a stacked list */
.hero-assure { margin-top: clamp(1.1rem, 2.4vw, 1.55rem); gap: 0.5rem 1.3rem; }
@media (min-width: 460px) { .hero-assure { display: flex; flex-wrap: wrap; } }
.hero-assure li { font-size: 0.86rem; }
.hero-assure .check-ico { width: 17px; height: 17px; }

/* ---------- the widget ---------- */
.hero-widget { display: flex; flex-direction: column; gap: 0.8rem; }
.widget {
  flex: 1; display: flex; flex-direction: column;
  background: var(--card); border: 1px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--sh-lg); padding: clamp(1.15rem, 2.2vw, 1.6rem);
  position: relative;
}
/* accent registration tick Ã¢â‚¬â€ ties the widget into the receipt/trust/pipeline system */
.widget::before { content: ""; position: absolute; top: -1px; left: clamp(1.15rem, 2.2vw, 1.6rem); width: 32px; height: 2px; background: var(--accent); border-radius: 1px; }
.widget-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.1rem; }
.widget-title { font-family: var(--font-display); font-weight: 600; font-size: 1.08rem; letter-spacing: -0.01em; }
.widget-badge { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.76rem; font-weight: 600; color: var(--ink-2); background: var(--well); padding: 0.34rem 0.66rem; border-radius: var(--r-pill); }

.stage { position: relative; flex: 1; min-height: clamp(330px, 40vh, 420px); }
.panel {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  opacity: 0; visibility: hidden; transform: translateY(10px); pointer-events: none;
  transition: opacity .42s var(--ease-out), transform .42s var(--ease-out);
}
.widget[data-state="idle"]      .panel[data-panel="idle"],
.widget[data-state="error"]     .panel[data-panel="idle"],
.widget[data-state="reading"]   .panel[data-panel="reading"],
.widget[data-state="estimate"]  .panel[data-panel="estimate"],
.widget[data-state="signin"]    .panel[data-panel="signin"],
.widget[data-state="balance"]   .panel[data-panel="balance"],
.widget[data-state="rendering"] .panel[data-panel="rendering"],
.widget[data-state="done"]      .panel[data-panel="done"] {
  opacity: 1; visibility: visible; transform: none; pointer-events: auto;
}

/* dropzone Ã¢â‚¬â€ "render frame" */
.panel-drop { gap: 0.95rem; }
.dropzone {
  position: relative; flex: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.05rem;
  text-align: center; padding: clamp(1.4rem, 3vw, 2.1rem);
  border-radius: var(--r-lg); background: var(--paper); cursor: pointer; overflow: hidden;
  box-shadow: inset 0 0 0 1px var(--line), inset 0 2px 6px oklch(0.26 0.02 62 / 0.05);
  transition: background .22s ease, box-shadow .22s ease;
}
.dropzone:hover { background: var(--paper-2); }
.widget.is-drag .dropzone { background: var(--accent-tint); box-shadow: inset 0 0 0 1.5px var(--accent); }

/* corner registration brackets */
.dz-corners i { position: absolute; width: 17px; height: 17px; border: 2px solid var(--line-2);
  transition: border-color .2s ease, top .25s var(--ease-out), left .25s var(--ease-out), right .25s var(--ease-out), bottom .25s var(--ease-out); }
.dz-corners i:nth-child(1) { top: 13px; left: 13px; border-right: 0; border-bottom: 0; border-top-left-radius: 5px; }
.dz-corners i:nth-child(2) { top: 13px; right: 13px; border-left: 0; border-bottom: 0; border-top-right-radius: 5px; }
.dz-corners i:nth-child(3) { bottom: 13px; left: 13px; border-right: 0; border-top: 0; border-bottom-left-radius: 5px; }
.dz-corners i:nth-child(4) { bottom: 13px; right: 13px; border-left: 0; border-top: 0; border-bottom-right-radius: 5px; }
.dropzone:hover .dz-corners i { border-color: var(--ink-3); }
.widget.is-drag .dz-corners i, .widget[data-state="error"] .dz-corners i { border-color: var(--accent); }
.widget.is-drag .dz-corners i:nth-child(1) { top: 9px; left: 9px; }
.widget.is-drag .dz-corners i:nth-child(2) { top: 9px; right: 9px; }
.widget.is-drag .dz-corners i:nth-child(3) { bottom: 9px; left: 9px; }
.widget.is-drag .dz-corners i:nth-child(4) { bottom: 9px; right: 9px; }
/* one-shot registration "lock": brackets snap inward to alignment on mount.
   Uses transform (not the top/left the drag state animates), so the two
   never fight. Runs once Ã¢â‚¬â€ panels are CSS-toggled, not remounted. */
.widget .dz-corners i { animation: bracketSnap 0.8s var(--ease-out) 0.85s both; }
.dz-corners i:nth-child(1) { --bx: -7px; --by: -7px; }
.dz-corners i:nth-child(2) { --bx:  7px; --by: -7px; }
.dz-corners i:nth-child(3) { --bx: -7px; --by:  7px; }
.dz-corners i:nth-child(4) { --bx:  7px; --by:  7px; }

/* .blend file token */
.blend-token { flex: none; position: relative; width: 56px; height: 68px; border-radius: 11px; background: var(--card); border: 1px solid var(--line-2);
  box-shadow: var(--sh-sm); display: flex; align-items: flex-end; justify-content: center; padding-bottom: 9px;
  transition: transform .28s var(--ease-out), box-shadow .28s var(--ease-out); }
.blend-token span { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; color: var(--ink-2); letter-spacing: -0.01em; }
.blend-token::before { content: ""; position: absolute; top: -1px; right: -1px; width: 17px; height: 17px; background: var(--paper-2);
  border-left: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); border-bottom-left-radius: 6px; border-top-right-radius: 11px; }
.blend-token::after { content: ""; position: absolute; left: 11px; top: 14px; width: 22px; height: 4px; border-radius: 2px; background: var(--accent); }
.dropzone:hover .blend-token, .widget.is-drag .blend-token { transform: translateY(-4px) rotate(-3.5deg); box-shadow: var(--sh-md); }

.dz-title { font-size: 1.05rem; font-weight: 600; color: var(--ink); }
.dz-title code { font-size: 0.9em; }
.dz-hint { font-size: 0.78rem; color: var(--ink-3); }
.drop-error { display: none; align-items: center; gap: 0.5rem; justify-content: center; font-size: 0.85rem; color: var(--accent-press); font-weight: 500; max-width: 30ch; }
.widget[data-state="error"] .drop-error { display: flex; }
