.acct-device-dot[data-state="live"] { background: var(--ok); box-shadow: 0 0 0 3px var(--ok-tint); }
.acct-device-meta { display: flex; flex-direction: column; gap: 0.16rem; min-width: 0; margin-right: auto; }
