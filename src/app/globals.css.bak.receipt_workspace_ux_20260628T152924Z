   finished "Rendered" frame. States Farpy's whole promise as a still. */
.compare { margin: clamp(2rem, 4vw, 3.25rem) 0 0; }
.compare-stage {
  position: relative; overflow: hidden; isolation: isolate;
  aspect-ratio: 4 / 3; max-height: 72vh;
  border: 1px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--sh-lg); background: var(--well);
}
