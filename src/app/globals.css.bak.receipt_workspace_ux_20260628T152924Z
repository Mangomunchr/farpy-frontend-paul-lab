.sample-btn { align-self: center; background: none; border: none; color: var(--ink-2); font-size: 0.88rem; font-weight: 500; padding: 0.45rem; }
.sample-btn:hover { color: var(--accent); }
.sample-btn u { text-decoration-color: var(--line-2); text-underline-offset: 3px; }

/* reading */
.panel-reading { align-items: center; justify-content: center; gap: 0.95rem; text-align: center; }
.spinner { width: 40px; height: 40px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--accent); animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.reading-title { font-size: 1.06rem; font-weight: 600; }
.reading-sub { font-family: var(--font-mono); font-size: 0.85rem; color: var(--ink-3); }

/* estimate */
.panel-estimate { gap: 1.05rem; justify-content: center; }
.file-row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-bottom: 0.95rem; border-bottom: 1px solid var(--line); }
.file-name { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: 0.96rem; min-width: 0; }
.file-name svg { width: 18px; height: 18px; color: var(--ink-3); flex: none; }
.file-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.estimate { display: grid; gap: 0.72rem; }
.est-line { display: flex; align-items: baseline; justify-content: space-between; font-size: 0.95rem; color: var(--ink-2); }
.est-line .mono { color: var(--ink); font-weight: 500; }
.est-total { align-items: center; padding-top: 0.78rem; border-top: 1px dashed var(--line-2); }
.est-total span:first-child { font-weight: 600; color: var(--ink); font-size: 1rem; }
.price { font-size: 1.7rem !important; font-weight: 600; color: var(--ink) !important; letter-spacing: -0.02em; }
.est-note { font-size: 0.82rem; color: var(--ink-3); margin: 0; }
.gate-hint { font-size: 0.8rem; color: var(--ink-3); margin: 0.2rem 0 0; text-align: center; }
.gate-hint strong { color: var(--ink-2); }

/* signin / balance */
.panel-gate, .panel-balance { gap: 0.85rem; justify-content: center; }
.panel-h { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.015em; }
.panel-p { font-size: 0.92rem; color: var(--ink-2); margin: -0.3rem 0 0.45rem; }
.bal-row { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.95rem; color: var(--ink-2); padding: 0.58rem 0; border-bottom: 1px solid var(--line); }
.bal-row .mono { color: var(--ink); font-weight: 500; }
.bal-row.need .mono { color: var(--accent-press); }
.topup-tiers { display: flex; gap: 0.5rem; margin: 0.45rem 0 0.2rem; }
.tier { flex: 1; background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 0.62rem 0.4rem; text-align: center; transition: border-color .18s ease, background .18s ease, transform .18s var(--ease-out); }
.tier:hover { border-color: var(--ink-3); transform: translateY(-1px); }
.tier.is-on { border-color: var(--accent); background: var(--accent-tint); }
.tier b { display: block; font-family: var(--font-mono); font-size: 1rem; color: var(--ink); }
.tier small { font-size: 0.7rem; color: var(--ink-3); }

/* rendering */
.panel-render { gap: 1.15rem; justify-content: center; }
.render-pips { display: flex; gap: 4px; }
.render-pips .pip { flex: 1; height: 8px; border-radius: 4px; background: var(--well); transition: background .3s var(--ease-out); }
.render-pips .pip.on { background: var(--accent); }
.progress { height: 8px; border-radius: 4px; background: var(--well); overflow: hidden; }
.progress-bar { height: 100%; width: 0; border-radius: 4px; background: var(--accent); transition: width .25s linear; }
.render-status { font-size: 0.86rem; color: var(--ink-2); text-align: center; }
.render-status b { color: var(--ink); }

/* done */
.panel-done { align-items: center; justify-content: center; gap: 0.72rem; text-align: center; }
.done-check { width: 56px; height: 56px; border-radius: 50%; background: var(--ok-tint); color: var(--ok); display: grid; place-items: center; animation: pop .5s var(--ease-out) both; }
.done-check svg { width: 28px; height: 28px; }
@keyframes pop { from { transform: scale(0.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.done-sub { font-size: 0.85rem; color: var(--ink-2); }
.panel-done .btn { margin-top: 0.45rem; }

.widget-foot { display: flex; align-items: center; gap: 0.5rem; justify-content: center; font-size: 0.78rem; color: var(--ink-3); margin: 0; padding: 0 0.5rem; }
.widget-foot svg { width: 14px; height: 14px; flex: none; }

/* ---------- proof filmstrip ---------- */
.proof { padding-bottom: clamp(2.5rem, 6vw, 4.5rem); }
.proof-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.15rem; }
.proof-label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); margin: 0; display: inline-flex; align-items: center; gap: 0.55rem; }
.proof-see { font-size: 0.88rem; font-weight: 600; color: var(--ink-2); display: inline-flex; align-items: center; gap: 0.3rem; transition: color .18s ease, gap .18s ease; }
.proof-see:hover { color: var(--accent); gap: 0.5rem; }
.proof-see svg { width: 15px; height: 15px; }
.marquee { position: relative; overflow: hidden; padding-bottom: 0.6rem;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%); }
.marquee-bleed { width: 100%; }   /* runs edge-to-edge; head stays in .wrap */
.marquee-track { display: flex; width: max-content; animation: marqueeFlow 42s linear infinite; will-change: transform; }
.marquee:hover .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
.render-card { flex: 0 0 auto; width: clamp(210px, 23vw, 256px); margin-right: clamp(0.85rem, 1.5vw, 1.15rem); }
@keyframes marqueeFlow { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } .marquee { overflow-x: auto; } }
.render-card a { display: block; }
.render-card .frame { display: block; position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--sh-sm); background: var(--well); }
.render-card .frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s var(--ease-out); }
.render-card a:hover .frame img { transform: scale(1.05); }
.render-card .verify { position: absolute; top: 0.6rem; right: 0.6rem; display: inline-flex; align-items: center; gap: 0.3rem; background: oklch(0.22 0.02 62 / 0.78); color: white; font-size: 0.68rem; font-weight: 600; padding: 0.24rem 0.5rem 0.24rem 0.4rem; border-radius: var(--r-pill); backdrop-filter: blur(4px); }
.render-card .verify svg { width: 11px; height: 11px; color: oklch(0.82 0.14 150); }
.render-card figcaption { margin-top: 0.65rem; display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
.render-card .cap-name { font-weight: 600; font-size: 0.9rem; color: var(--ink); }
.render-card .cap-meta { font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-3); white-space: nowrap; }

/* ---------- entrance ---------- */
@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
.anim { animation: rise 1.05s var(--ease-out) both; }
.anim-1 { animation-delay: 0.05s; }
.anim-2 { animation-delay: 0.18s; }
.anim-3 { animation-delay: 0.30s; }
.anim-4 { animation-delay: 0.42s; }
.anim-p { animation: rise 1.1s var(--ease-out) 0.42s both; }

/* the hero grid develops like an exposure (opacity only Ã¢â‚¬â€ transform is held
   for the scroll parallax) */
@keyframes gridDevelop { from { opacity: 0; } to { opacity: 1; } }

/* signature first-load: the headline resolves out of blur, the way a frame
   denoises into focus Ã¢â‚¬â€ Farpy's whole promise, stated in motion */
.hero-h1 { animation: heroResolve 1.35s var(--ease-out) 0.08s both; }
@keyframes heroResolve {
  0%   { opacity: 0; transform: translateY(16px) scale(1.012); filter: blur(14px); }
  55%  { opacity: 1; }
  100% { opacity: 1; transform: none; filter: blur(0); }
}

/* the widget settles up with a touch of scale, like a panel docking */
.anim-w { animation: widgetIn 1.25s var(--ease-out) 0.3s both; }
@keyframes widgetIn {
  from { opacity: 0; transform: translateY(24px) scale(0.985); }
  to   { opacity: 1; transform: none; }
}

/* registration brackets snapping into alignment (timing on .dz-corners i) */
@keyframes bracketSnap {
  from { opacity: 0; transform: translate(var(--bx, 0), var(--by, 0)); }
  to   { opacity: 1; transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}

/* ============================================================
   Scroll reveal
   The boot script adds `reveals-on` to <html> only when motion is
   allowed and IntersectionObserver exists; without it these rules
   never apply, so content is always visible for no-JS / reduced
   motion. ScrollReveal.tsx staggers groups and toggles .is-in.
   ============================================================ */
.reveals-on [data-reveal] {
  opacity: 0;
  transform: translate3d(0, 26px, 0);
  transition:
    opacity 0.72s var(--ease-out),
    transform 0.72s var(--ease-out),
    filter 0.72s var(--ease-out);
  transition-delay: var(--reveal-delay, 0ms);
}
.reveals-on [data-reveal="fade"]    { transform: none; }
.reveals-on [data-reveal="rise-sm"] { transform: translate3d(0, 16px, 0); }
.reveals-on [data-reveal="resolve"] { transform: translate3d(0, 16px, 0) scale(1.014); filter: blur(12px); }
.reveals-on [data-reveal].is-in {
  opacity: 1;
  transform: none;
  filter: none;
}

/* accent registration ticks draw left-to-right as their host settles */
.reveals-on .step::before,
.reveals-on .receipt::before {
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.6s var(--ease-out);
  transition-delay: calc(var(--reveal-delay, 0ms) + 0.14s);
}
.reveals-on .step.is-in::before,
.reveals-on .receipt.is-in::before { transform: scaleX(1); }

/* the closing slab: faint grid develops, warm spotlight blooms once */
.reveals-on .final-cta::before { opacity: 0; transition: opacity 1.1s 0.1s var(--ease-out); }
.reveals-on .final-cta.is-in::before { opacity: 1; }
.reveals-on .final-cta::after {
  opacity: 0;
  transform: translateX(-50%) scale(0.55);
  transition: opacity 1s 0.12s var(--ease-out), transform 1.2s 0.12s var(--ease-out);
}
.reveals-on .final-cta.is-in::after { opacity: 1; transform: translateX(-50%) scale(1); }

/* ---------- faq (native <details>) ---------- */
.faq-item { position: relative; border-bottom: 1px solid var(--line); }
.faq-item:first-child { border-top: 1px solid var(--line); }
.faq-item > summary { list-style: none; cursor: pointer; }
.faq-item > summary::-webkit-details-marker { display: none; }
.faq-summary {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: clamp(1.1rem, 2vw, 1.35rem) 0;
  font-family: var(--font-display); font-weight: 600;
  font-size: clamp(1.02rem, 1.4vw, 1.15rem); letter-spacing: -0.01em;
