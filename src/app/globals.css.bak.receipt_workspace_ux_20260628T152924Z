}
.faq-q { display: inline-flex; align-items: center; gap: 0.85rem; min-width: 0; }
.faq-tick { flex: none; width: 14px; height: 2px; border-radius: 1px; background: var(--line-2); transition: background .2s ease, width .25s var(--ease-out); }
.faq-item:hover .faq-tick { background: var(--ink-3); }
