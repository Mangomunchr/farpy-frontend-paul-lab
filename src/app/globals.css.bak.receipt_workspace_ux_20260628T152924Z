.compare-meta { position: absolute; left: clamp(0.7rem, 1.6vw, 1.05rem); bottom: clamp(0.7rem, 1.6vw, 1.05rem); z-index: 3; font-size: 0.72rem; color: var(--ink-2); background: var(--card); border: 1px solid var(--line); padding: 0.3rem 0.62rem; border-radius: var(--r-pill); box-shadow: var(--sh-sm); }

