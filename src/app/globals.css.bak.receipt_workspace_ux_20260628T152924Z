  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-4);
}
.render-status-hero {
  gap: var(--spacing-4);
  padding: clamp(1.15rem, 3vw, 1.75rem);
}
.render-status-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-4);
}
.render-status-main strong {
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: clamp(60px, 13vw, 112px);
  line-height: .9;
}
.render-status-main span {
  color: var(--ink-2);
  font-size: 14px;
}
.render-progress-bar-large {
  height: clamp(18px, 3vw, 28px);
}
.render-compact-status {
  display: grid;
  gap: var(--spacing-3);
  padding-bottom: var(--spacing-2);
  border-bottom: 1px solid var(--line);
}
.render-compressed-top {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: clamp(0.9rem, 2.5vw, 1.4rem);
  row-gap: var(--spacing-2);
  align-items: center;
}
.render-status-icon {
  width: clamp(52px, 11vw, 68px);
  height: clamp(52px, 11vw, 68px);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: clamp(24px, 4.5vw, 34px);
  font-weight: 800;
  line-height: 1;
  text-align: center;
}
.render-status-icon-complete {
  border-color: var(--ok-tint);
  background: var(--ok-tint);
  color: var(--ok);
}
.render-status-icon-running,
.render-status-icon-submitted {
  border-color: var(--accent-tint);
  background: var(--accent-tint);
  color: var(--accent-press);
}
.render-status-icon-failed {
  border-color: var(--danger-tint);
  background: var(--danger-tint);
  color: var(--danger);
}
.render-compressed-copy {
  min-width: 0;
  display: grid;
  gap: 0.42rem;
}
.render-compressed-copy h2 {
  margin: 0;
  color: var(--ink);
  font-size: clamp(30px, 7vw, 46px);
  line-height: 0.98;
  letter-spacing: 0;
}
.render-compressed-copy p {
  margin: 0;
  color: var(--ink-2);
  font-size: clamp(15px, 2vw, 17px);
}
.render-file-name {
  min-width: 0;
  color: var(--ink);
  font-size: clamp(15px, 2vw, 17px);
  overflow-wrap: anywhere;
}
.render-job-summary {
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: 13px;
}
.render-status-copy {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-3);
}
.render-status-copy div {
  display: grid;
  gap: 0.25rem;
  min-width: 0;
}
.render-status-copy strong {
  color: var(--ink);
  font-size: clamp(20px, 4vw, 28px);
  line-height: 1.1;
}
.render-status-copy span:last-child {
  color: var(--ink-2);
  font-size: 14px;
}
.render-pulse-dot {
  width: 9px;
  height: 9px;
  margin-top: 0.45rem;
  flex: none;
  border-radius: 50%;
  background: var(--ink-3);
}
.render-pulse-dot-running,
.render-pulse-dot-submitted {
  background: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-tint);
  animation: render-dot-pulse 1.2s ease-in-out infinite;
}
.render-pulse-dot-complete {
  background: var(--ok);
  box-shadow: 0 0 0 4px var(--ok-tint);
}
.render-pulse-dot-failed {
  background: var(--danger);
  box-shadow: 0 0 0 4px var(--danger-tint);
}
@keyframes render-dot-pulse {
  0%, 100% { transform: scale(0.9); opacity: 0.72; }
  50% { transform: scale(1.12); opacity: 1; }
}
.render-progress-compact {
  display: grid;
  gap: var(--spacing-2);
}
.render-progress-row b {
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 12px;
}
.render-progress-bar-waiting {
  position: relative;
}
.render-progress-bar-waiting span {
  width: 10px;
  border-radius: 50%;
  animation: render-waiting-dot 1.1s ease-in-out infinite alternate;
}
@keyframes render-waiting-dot {
  from { transform: translateX(0); opacity: 0.45; }
  to { transform: translateX(30px); opacity: 1; }
}
.render-dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-3);
  margin: 0;
}
.render-dashboard-grid div {
  display: grid;
  gap: 0.28rem;
  min-width: 0;
  padding: var(--spacing-3);
  border: 1px solid var(--line);
  border-radius: var(--radius-2);
  background: var(--paper);
}
.render-dashboard-grid dt {
  color: var(--ink-3);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}
.render-dashboard-grid dd {
  margin: 0;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 13px;
  overflow-wrap: anywhere;
}
.render-dashboard-grid .render-inline-input,
.render-dashboard-grid .render-number-input,
.render-dashboard-grid .render-select {
  min-width: 0;
}
.render-state-controls .pj-btn[aria-pressed="true"],
.money-card[aria-pressed="true"] {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 1px var(--accent);
}
.render-timeline {
  display: grid;
  gap: 0.6rem;
  margin: var(--spacing-2) 0 0;
  padding: var(--spacing-3);
  border: 1px solid var(--line);
  border-radius: var(--radius-2);
  background: var(--paper);
  list-style: none;
}
.render-timeline-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  color: var(--ink-3);
  font-size: 13px;
}
.render-timeline-item > span {
  width: 18px;
  height: 18px;
  flex: none;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
  background: var(--paper-2);
  display: grid;
  place-items: center;
  color: white;
  font-size: 12px;
  font-weight: 800;
  line-height: 1;
  text-align: center;
}
.render-timeline-item strong {
  font-weight: 600;
}
.render-timeline-item-done {
  color: var(--ink-2);
}
.render-timeline-item-done > span {
  border-color: var(--ok);
  background: var(--ok);
}
.render-timeline-item-active {
  color: var(--accent-press);
}
.render-timeline-item-active > span {
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-tint);
}
.render-timeline-item-failed {
  color: var(--accent-press);
}
.render-timeline-item-failed > span {
  border-color: var(--accent);
  background: var(--accent-tint);
  color: var(--accent-press);
  box-shadow: 0 0 0 4px var(--accent-tint);
}
.render-details {
  border: 1px solid var(--line);
  border-radius: var(--radius-2);
  background: var(--paper);
}
.render-details summary {
  cursor: pointer;
  padding: var(--spacing-3);
  color: var(--ink);
  font-weight: 700;
  list-style-position: inside;
}
.render-details .render-dashboard-grid {
  padding: 0 var(--spacing-3) var(--spacing-3);
}
@media (max-width: 560px) {
  .render-compressed-top {
    grid-template-columns: 1fr;
  }
  .render-actions-primary .pj-btn,
  .render-disabled-action {
    width: 100%;
    justify-content: center;
  }
}
.proof-head h1 {
  font-family: var(--font-mono);
  font-size: clamp(28px, 5vw, 42px);
  overflow-wrap: anywhere;
}
.proof-url,
.proof-url-value {
  overflow-wrap: anywhere;
}
.proof-url {
  display: inline-flex;
  width: fit-content;
  margin: 0;
  padding: .45rem .65rem;
  border: 1px solid var(--line);
  border-radius: var(--radius-2);
  background: var(--paper);
  color: var(--ink-2);
  font-family: var(--font-mono);
  font-size: 12px;
}
.proof-receipt-card {
  gap: var(--spacing-5);
}
.proof-receipt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-4);
}
.proof-receipt-head strong {
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: clamp(42px, 9vw, 76px);
  line-height: 1;
  text-align: center;
}
.money-compact .render-flow-head {
  text-align: center;
}
.money-compact .render-flow-head p {
  margin: 0;
}
.money-compact .render-flow-head strong {
  font-family: var(--font-mono);
  font-size: clamp(48px, 12vw, 86px);
  line-height: 1;
  text-align: center;
}
.money-compact .money-card {
  align-items: center;
  justify-items: center;
  text-align: center;
}
.signin-compact .fy-auth__card {
  padding: var(--spacing-6);
}
.account-balance-card {
  grid-template-columns: 1fr auto;
  align-items: center;
}
.account-balance-card .render-price {
  font-size: clamp(48px, 10vw, 84px);
}
.account-list {
  margin: 0;
  padding: 0;
}
.account-actions {
  justify-content: center;
}
@media (max-width: 640px) {
  .render-dashboard-head,
  .render-status-main,
  .proof-receipt-head {
    align-items: flex-start;
    flex-direction: column;
  }
  .render-dashboard-grid,
  .account-balance-card {
    grid-template-columns: 1fr;
  }
}

