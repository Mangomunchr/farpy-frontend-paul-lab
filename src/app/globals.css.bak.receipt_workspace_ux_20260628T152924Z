/* roadmap Ã¢â‚¬â€ honest "not yet" list, visually quieter than the live endpoints */
.api-roadmap { list-style: none; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; gap: 0.85rem; }
@media (min-width: 720px) { .api-roadmap { grid-template-columns: 1fr 1fr; } }
.api-roadmap-item { border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1rem, 2vw, 1.3rem) clamp(1.1rem, 2.2vw, 1.5rem); background: var(--paper-2); }
.api-roadmap-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
.api-roadmap-title { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.012em; color: var(--ink); margin: 0; }
.api-tag { flex: none; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); background: var(--well); border: 1px solid var(--line); padding: 0.2rem 0.5rem; border-radius: var(--r-pill); }
.api-roadmap-desc { margin: 0.55rem 0 0; font-size: 0.92rem; color: var(--ink-2); max-width: 50ch; }

/* ============================================================
   Top-up page (/topup) Ã¢â‚¬â€ add render balance.
   Reuses .h1 / .lede / .assure / .section-* / .trust-item /
   .receipt-lines / .receipt-total / .faq / .btn. The composer
   is the receipt artifact: pick an amount, watch the frames +
   new balance resolve, then check out. Priced in plain USD,
   never "beans".
   ============================================================ */
.topup-hero { padding-top: clamp(2.25rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 5vw, 3.5rem); }
.topup-hero-grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
@media (min-width: 900px) {
  .topup-hero-grid { grid-template-columns: 1.02fr 0.98fr; align-items: stretch; }
  .topup-hero-copy { display: flex; flex-direction: column; justify-content: center; }
  .topup-composer-wrap { display: flex; flex-direction: column; justify-content: center; }
}

/* current-balance line under the assurances */
.topup-balance-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin: clamp(1.5rem, 3vw, 2rem) 0 0; padding-top: 1.1rem; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--ink-3); }
.topup-balance-line b { font-size: 1.15rem; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; }

/* ---- the composer (receipt artifact) ---- */
.topup-composer { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-xl); box-shadow: var(--sh-lg); padding: clamp(1.3rem, 2.6vw, 1.85rem); }
.topup-composer::before { content: ""; position: absolute; top: -1px; left: clamp(1.3rem, 2.6vw, 1.85rem); width: 40px; height: 2px; background: var(--accent); }
.topup-composer-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.15rem; }
.topup-composer-title { font-family: var(--font-display); font-weight: 600; font-size: 1.18rem; letter-spacing: -0.015em; color: var(--ink); margin: 0; }
.topup-rate { font-size: 0.82rem; color: var(--ink-3); background: var(--well); padding: 0.3rem 0.62rem; border-radius: var(--r-pill); }

/* preset amount grid */
.topup-amounts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
.topup-amount { position: relative; text-align: left; background: var(--paper); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 0.85rem 0.9rem; display: flex; flex-direction: column; gap: 0.2rem; box-shadow: inset 0 1px 2px oklch(0.26 0.02 62 / 0.04); transition: border-color .18s ease, background .18s ease, transform .18s var(--ease-out), box-shadow .18s ease; }
.topup-amount:hover { border-color: var(--ink-3); transform: translateY(-1px); }
.topup-amount.is-on { border-color: var(--accent); background: var(--accent-tint); box-shadow: 0 0 0 1px var(--accent); }
.topup-amount b { font-size: 1.3rem; font-weight: 600; color: var(--ink); letter-spacing: -0.02em; line-height: 1.1; }
.topup-amount small { font-size: 0.74rem; color: var(--ink-3); }
.topup-amount.is-on small { color: var(--accent-press); }
.topup-amount-badge { position: absolute; top: -0.6rem; right: 0.7rem; font-size: 0.62rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent); padding: 0.18rem 0.5rem; border-radius: var(--r-pill); box-shadow: var(--sh-sm); }
.topup-methods { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; margin: 1rem 0 0.85rem; padding: 0.25rem; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--well); }
.topup-method { border: 0; border-radius: calc(var(--r-md) - 3px); background: transparent; color: var(--ink-2); font: inherit; font-size: 0.88rem; font-weight: 600; padding: 0.62rem 0.7rem; cursor: pointer; }
.topup-method.is-active { background: var(--paper); color: var(--ink); box-shadow: var(--sh-sm); }
.topup-method--disabled,
.topup-method--disabled:disabled { opacity: 0.48; cursor: not-allowed; box-shadow: none; }
.topup-method--disabled span { display: inline-block; margin-right: 0.35rem; font-size: 0.68rem; line-height: 1; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.04em; }
.topup-lightning-hold { margin: -0.25rem 0 0.85rem; }
.topup-lightning-panel { display: grid; gap: 0.8rem; }
.topup-invoice { display: grid; gap: 0.45rem; margin-top: 0.25rem; padding: 0.95rem; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--paper); }
.topup-invoice strong { font-family: var(--font-mono); font-size: 0.92rem; overflow-wrap: anywhere; }
.topup-invoice p { margin: 0; color: var(--ink-2); font-size: 0.86rem; }
.topup-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.25rem; }

/* custom amount */
.topup-custom { margin-top: 1rem; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.5rem 0.85rem; }
.topup-custom-label { grid-column: 1 / -1; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
.topup-custom-field { display: inline-flex; align-items: center; gap: 0.3rem; background: var(--well); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 0.55rem 0.85rem; font-size: 1.05rem; font-weight: 600; color: var(--ink-3); transition: border-color .18s ease, box-shadow .18s ease, color .18s ease; }
.topup-custom-field.is-active { color: var(--ink); }
.topup-custom-field:focus-within { border-color: var(--ink); box-shadow: none; color: var(--ink); }
.topup-custom-field input { width: 6ch; border: none; background: none; outline: none; font: inherit; color: var(--ink); padding: 0; }
.topup-custom-field input::placeholder { color: var(--line-2); }
.topup-custom-hint { font-size: 0.8rem; color: var(--ink-3); white-space: nowrap; }

/* receipt summary (reuses .receipt-lines / .receipt-total) */
.topup-lines { padding: 1.15rem 0 0; margin-top: 1.15rem; border-top: 1px solid var(--line); }
.topup-total { margin-top: 0.95rem; }

.topup-checkout { margin-top: 1.25rem; --pad-y: 0.92rem; font-size: 1rem; }
.topup-checkout svg { width: 17px; height: 17px; }
.topup-lightning { display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem; width: 100%; margin-top: 0.7rem; background: none; border: none; font-size: 0.88rem; font-weight: 600; color: var(--ink-2); padding: 0.35rem; transition: color .18s ease; }
.topup-lightning svg { width: 15px; height: 15px; }
.topup-lightning:hover { color: var(--accent); }
.topup-secure { display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin: 0.85rem 0 0; font-size: 0.78rem; color: var(--ink-3); }

/* success state */
.topup-done { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.5rem; padding-top: clamp(1.8rem, 4vw, 2.6rem); padding-bottom: clamp(1.8rem, 4vw, 2.6rem); }
.topup-done-mark { width: 56px; height: 56px; border-radius: 50%; background: var(--ok-tint); color: var(--ok); display: grid; place-items: center; margin-bottom: 0.45rem; animation: pop .5s var(--ease-out) both; }
.topup-done-mark .check-ico { width: 28px; height: 28px; }
.topup-done-title { font-family: var(--font-display); font-weight: 700; font-size: 1.32rem; letter-spacing: -0.02em; color: var(--ink); margin: 0; }
.topup-done-sub { font-size: 0.95rem; color: var(--ink-2); margin: 0; max-width: 34ch; }
.topup-done-balance { display: inline-flex; align-items: baseline; gap: 0.5rem; margin: 0.85rem 0 0.35rem; padding: 0.5rem 1rem; background: var(--well); border: 1px solid var(--line); border-radius: var(--r-pill); }
.topup-done-balance small { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
.topup-done-balance b { font-size: 1.1rem; font-weight: 600; color: var(--ink); }
.topup-done .btn { margin-top: 0.85rem; }
.topup-done .btn svg { width: 17px; height: 17px; }

/* ---- includes band (ruled + accent tick, reuses .trust-item) ---- */
.topup-includes { display: grid; gap: clamp(1.4rem, 3vw, 2.25rem) clamp(1.5rem, 3vw, 2.5rem); grid-template-columns: 1fr; }
@media (min-width: 560px) { .topup-includes { grid-template-columns: 1fr 1fr; } }
@media (min-width: 920px) { .topup-includes { grid-template-columns: repeat(4, 1fr); } }
.topup-include-lead { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; letter-spacing: -0.01em; color: var(--ink); margin: 0; }
.topup-include-rest { font-size: 0.9rem; color: var(--ink-2); margin: 0.4rem 0 0; max-width: 30ch; }

/* ---- manual rails ---- */
.topup-rails { list-style: none; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; gap: clamp(0.9rem, 2vw, 1.25rem); grid-template-columns: 1fr; }
@media (min-width: 620px) { .topup-rails { grid-template-columns: 1fr 1fr; } }
@media (min-width: 1040px) { .topup-rails { grid-template-columns: repeat(4, 1fr); } }
.topup-rail { display: flex; flex-direction: column; background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.15rem, 2.2vw, 1.45rem); transition: border-color .2s ease, box-shadow .2s ease, transform .2s var(--ease-out); }
.topup-rail:hover { border-color: var(--line-2); box-shadow: var(--sh-md); transform: translateY(-2px); }
.topup-rail-region { position: relative; display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); padding-top: 0.85rem; }
.topup-rail-region::before { content: ""; position: absolute; top: 0; left: 0; width: 26px; height: 2px; border-radius: 1px; background: var(--accent); }
.topup-rail-title { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.012em; color: var(--ink); margin: 0.7rem 0 0; }
.topup-rail-desc { font-size: 0.9rem; line-height: 1.5; color: var(--ink-2); margin: 0.5rem 0 0; }
.topup-rail-methods { font-size: 0.76rem; color: var(--ink-3); margin: 0.85rem 0 0; }
.topup-rail-action { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: auto; padding-top: 1.1rem; font-size: 0.88rem; font-weight: 600; color: var(--ink); transition: gap .18s ease, color .18s ease; }
.topup-rail-action svg { width: 15px; height: 15px; transition: transform .18s ease; }
.topup-rail-action:hover { color: var(--accent); gap: 0.55rem; }
.topup-rail-action:hover svg { transform: translateX(2px); }
.topup-rails-foot { margin: clamp(1.6rem, 3vw, 2.2rem) 0 0; font-size: 0.84rem; line-height: 1.55; color: var(--ink-3); max-width: 64ch; }

/* ---- questions ---- */
.topup-faq { margin-top: clamp(1.75rem, 3.5vw, 2.5rem); max-width: 760px; }

/* ============================================================
   Account page (/account) Ã¢â‚¬â€ the signed-in settings hub.
   Rides in the workspace shell (.ws masthead + 1040px wrap) and
   reuses .btn / .text-btn / .mono. Two columns: a sticky section
   index + stacked setting cards. New button variants for the
   destructive actions live here too.
   ============================================================ */
.btn-danger { background: var(--accent); color: var(--accent-ink); box-shadow: var(--sh-sm), inset 0 1px 0 oklch(1 0 0 / 0.18); }
.btn-danger:hover { background: var(--accent-press); transform: translateY(-1px); box-shadow: var(--sh-md); }
.btn-danger-outline { background: var(--card); color: var(--accent-press); border-color: oklch(0.86 0.07 40); }
.btn-danger-outline:hover { background: var(--accent-tint); border-color: var(--accent); transform: translateY(-1px); }
.btn .check-ico { width: 1.05em; height: 1.05em; }
.btn-primary.is-saved { background: var(--ok); }
.btn-primary.is-saved:hover { background: var(--ok); }

.acct-head { margin-bottom: clamp(1.6rem, 3.5vw, 2.5rem); }

.acct-layout { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
@media (min-width: 900px) { .acct-layout { grid-template-columns: 210px 1fr; gap: clamp(2rem, 4vw, 3.25rem); } }

/* sticky section index */
.acct-index { display: none; }
@media (min-width: 900px) {
  .acct-index { display: block; position: sticky; top: 96px; }
  .acct-index ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1rem; border-left: 1px solid var(--line); }
  .acct-index a { display: block; padding: 0.5rem 0 0.5rem 1rem; margin-left: -1px; font-size: 0.92rem; font-weight: 500; color: var(--ink-3); border-left: 2px solid transparent; transition: color .18s ease, border-color .18s ease; }
  .acct-index a:hover { color: var(--ink-2); }
  .acct-index a.is-on { color: var(--ink); font-weight: 600; border-left-color: var(--accent); }
}

.acct-panels { display: grid; gap: clamp(1.1rem, 2.4vw, 1.6rem); min-width: 0; }

/* settings card */
.acct-card { scroll-margin-top: 96px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-sm); padding: clamp(1.3rem, 2.6vw, 1.85rem); }
.acct-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.3rem; }
.acct-card-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.15rem, 2vw, 1.32rem); letter-spacing: -0.018em; color: var(--ink); margin: 0; }
.acct-card-sub { font-size: 0.9rem; color: var(--ink-2); margin: 0.32rem 0 0; max-width: 48ch; }
.acct-card-head .btn { flex: none; white-space: nowrap; }
.acct-card-head .btn svg { width: 15px; height: 15px; }

.acct-actions { display: flex; align-items: center; gap: 0.85rem 1rem; flex-wrap: wrap; margin-top: 1.3rem; }
.acct-hint { font-size: 0.82rem; color: var(--ink-3); }
.acct-note { font-size: 0.84rem; line-height: 1.55; color: var(--ink-3); margin: 1.1rem 0 0; }

/* fields */
.acct-fields { display: grid; gap: 1.1rem; }
@media (min-width: 560px) { .acct-fields { grid-template-columns: 1fr 1fr; } }
.acct-field { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
.acct-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); }
.acct-input { width: 100%; font: inherit; font-size: 0.96rem; color: var(--ink); background: var(--well); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 0.62rem 0.8rem; transition: border-color .18s ease, box-shadow .18s ease; }
.acct-input:focus { outline: none; border-color: var(--ink); }
.acct-input[readonly] { color: var(--ink-2); background: var(--paper-2); cursor: default; }

/* identity row */
.acct-identity { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.4rem; padding-bottom: 1.4rem; border-bottom: 1px solid var(--line); }
.acct-avatar { width: 52px; height: 52px; flex: none; border-radius: 50%; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--accent-press); background: var(--accent-tint); border: 1px solid oklch(0.88 0.05 40); }
.acct-identity-meta { display: flex; flex-direction: column; gap: 0.18rem; min-width: 0; }
