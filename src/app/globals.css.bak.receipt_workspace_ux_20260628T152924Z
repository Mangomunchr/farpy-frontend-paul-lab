.acct-switch-knob { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%; background: var(--card); box-shadow: var(--sh-sm); transition: transform .22s var(--ease-out); }
.acct-switch[aria-checked="true"] { background: var(--accent); border-color: var(--accent); }
.acct-switch[aria-checked="true"] .acct-switch-knob { transform: translateX(18px); }

/* security + danger zone */
.acct-sec-rows { display: grid; gap: 0; }
.acct-sec-row { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 0.95rem 0; border-bottom: 1px solid var(--line); }
.acct-sec-row:first-child { padding-top: 0; }
.acct-sec-meta { display: flex; flex-direction: column; gap: 0.16rem; min-width: 0; margin-right: auto; }
.acct-sec-meta b { font-weight: 600; font-size: 0.94rem; color: var(--ink); }
.acct-sec-meta span { font-size: 0.82rem; color: var(--ink-3); }
.acct-sec-row .btn { flex: none; }

.acct-danger { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.3rem; padding: clamp(1rem, 2.2vw, 1.25rem); border: 1px solid oklch(0.86 0.07 40); border-radius: var(--r-md); background: var(--accent-tint); }
.acct-danger .btn { flex: none; }
.acct-danger-confirm { display: inline-flex; align-items: center; gap: 0.75rem; flex: none; }
.acct-danger-confirm > span { font-size: 0.88rem; font-weight: 600; color: var(--accent-press); }

/* ============================================================
   Auth screen (/signin, /signup) Ã¢â‚¬â€ standalone, chrome-less.
   No site nav, no footer, no page scroll: a full-viewport split
   layout Ã¢â‚¬â€ dark brand stage left, form panel right Ã¢â‚¬â€ that col-
   lapses to the form alone on small screens. Reuses the brand
   motifs (masked grid + accent radial on the dark stage, accent
   tick + --card surface on the form card). Same studio-light
   furniture as /topup Ã¢â‚¬â€ no eyebrow pills, no gradient washes.
   ============================================================ */
.auth-shell { display: grid; grid-template-columns: 1fr; height: 100dvh; overflow: hidden; }
@media (min-width: 880px) { .auth-shell { grid-template-columns: 1.08fr 0.92fr; } }

/* ---- left: dark brand stage (desktop only) ---- */
/* three-zone grid: head cluster (brand + copy) pinned top, donut hero in the
   flexible middle, foot pinned bottom. Reads top-down: identity, then promise,
   then the product rendering itself. */
.auth-stage {
  display: none; position: relative; isolation: isolate; overflow: hidden;
  background: var(--ink); color: var(--paper);
  padding: clamp(2rem, 4vw, 3.25rem);
  grid-template-rows: auto minmax(0, 1fr) auto;
  gap: clamp(1.5rem, 3vh, 2.5rem);
}
@media (min-width: 880px) { .auth-stage { display: grid; } }
/* faint grid, masked to the edges so it adds structure without noise */
.auth-stage::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background-image:
    linear-gradient(to right, oklch(1 0 0 / 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(1 0 0 / 0.05) 1px, transparent 1px);
  background-size: clamp(46px, 4vw, 70px) clamp(46px, 4vw, 70px);
  -webkit-mask-image: radial-gradient(120% 120% at 30% 20%, #000 30%, transparent 80%);
  mask-image: radial-gradient(120% 120% at 30% 20%, #000 30%, transparent 80%);
}
/* warm accent glow, bottom-right */
.auth-stage::after {
  content: ""; position: absolute; z-index: -1; pointer-events: none;
  bottom: -45%; right: -15%; width: min(620px, 90%); aspect-ratio: 1;
  background: radial-gradient(circle, oklch(0.635 0.198 33 / 0.22), transparent 60%);
}
/* head cluster Ã¢â‚¬â€ brand sits above the value-prop copy */
.auth-stage-head { position: relative; z-index: 1; display: grid; gap: clamp(1.6rem, 4vh, 2.75rem); align-content: start; }
.auth-stage-brand { color: var(--paper); }
.auth-stage-copy { max-width: 30ch; }
.auth-stage-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.6rem, 2.8vw, 2.15rem); line-height: 1.04; letter-spacing: -0.026em; word-spacing: 0.05em; color: var(--paper); margin: 0; text-wrap: balance; }
.auth-stage-sub { font-size: 0.95rem; line-height: 1.6; color: oklch(0.9 0.008 80 / 0.74); margin: 0.85rem 0 0; max-width: 38ch; }
.auth-stage-sub code { background: oklch(1 0 0 / 0.08); color: oklch(0.95 0.008 80); }

/* the donut Ã¢â‚¬â€ centered in the flexible middle row. The frame is landscape
   because the donut is wider than tall (the camera frames it horizontally); a
   square crops its sides. A soft pool of light grounds it so it doesn't float
   in flat void. */
.auth-stage-donut { position: relative; z-index: 0; isolation: isolate; min-height: 0; display: grid; place-items: center; }
.auth-stage-donut::before {
  content: ""; position: absolute; z-index: -1; inset: 0; pointer-events: none;
  background: radial-gradient(58% 52% at 50% 54%, oklch(0.8 0.05 50 / 0.16), transparent 72%);
}
.auth-stage-canvas { width: 100%; max-width: 740px; aspect-ratio: 3 / 2; max-height: 100%; }

/* bare viewport: strip the chrome so the donut floats on the dark stage */
.viewport-bare { width: 100%; height: 100%; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.viewport-bare .vp-stage { position: relative; width: 100%; height: 100%; aspect-ratio: auto; }
.viewport-bare .vp-canvas { cursor: grab; }

.auth-stage-foot { position: relative; z-index: 1; font-size: 0.78rem; color: oklch(0.9 0.008 80 / 0.45); margin: 0; }

/* ---- right: the form panel ---- */
/* top bar (back link + mobile brand) pinned up top, card centered below */
.auth-panel {
  position: relative; isolation: isolate;
  display: grid; grid-template-rows: auto 1fr;
  padding: clamp(1.25rem, 3vw, 2rem);
  /* a touch deeper than the card so the near-white surface separates
     without leaning on shadow alone */
  background: var(--paper-2);
  overflow-y: auto; /* safety net on very short screens; the page itself never scrolls */
}
/* the same Blender-viewport grid as the dark stage, whispered Ã¢â‚¬â€ concentrated
   at the edges and masked away from the centered card. Ties the two halves of
   the split into one page instead of a dark panel beside a flat cream one. */
.auth-panel::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background-image:
    linear-gradient(to right, oklch(0.50 0.005 255 / 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, oklch(0.50 0.005 255 / 0.05) 1px, transparent 1px);
  background-size: clamp(46px, 4vw, 70px) clamp(46px, 4vw, 70px);
  -webkit-mask-image: radial-gradient(115% 90% at 50% 50%, transparent 38%, #000 82%);
  mask-image: radial-gradient(115% 90% at 50% 50%, transparent 38%, #000 82%);
}
.auth-panel-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.auth-panel-brand { margin: 0; }
@media (min-width: 880px) { .auth-panel-brand { display: none; } } /* brand lives on the stage */

/* the card Ã¢â‚¬â€ the "modal" surface, centered in the panel's lower zone */
.auth-card {
  position: relative; place-self: center; width: min(420px, 100%);
  background: var(--card); border: 1px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--sh-lg); padding: clamp(1.6rem, 3vw, 2.25rem);
}
.auth-card::before { content: ""; position: absolute; top: -1px; left: clamp(1.6rem, 3vw, 2.25rem); width: 40px; height: 2px; background: var(--accent); }
.auth-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.45rem, 3vw, 1.8rem); line-height: 1.05; letter-spacing: -0.025em; color: var(--ink); margin: 0; text-wrap: balance; }
.auth-sub { font-size: 0.95rem; line-height: 1.55; color: var(--ink-2); margin: 0.55rem 0 1.5rem; max-width: 42ch; }

/* Google button Ã¢â‚¬â€ .btn-oauth is the dark slab; give it a little more room */
.auth .btn-oauth { --pad-y: 0.82rem; font-size: 0.98rem; }
.auth .btn-oauth svg { width: 18px; height: 18px; flex: none; }

/* ruled "or" divider */
.auth-or { display: flex; align-items: center; gap: 0.85rem; margin: 1.2rem 0; color: var(--ink-3); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
.auth-or::before, .auth-or::after { content: ""; flex: 1; height: 1px; background: var(--line); }

/* form */
.auth-form { display: flex; flex-direction: column; gap: 0.5rem; }
.auth-input { font-size: 1rem; padding: 0.74rem 0.9rem; }
/* one clean accent ring Ã¢â‚¬â€ border + a same-colour 1px shadow read as a single
   crisp band, not a saturated border wrapped in a pale tint halo */
.auth-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.auth-submit { margin-top: 0.45rem; --pad-y: 0.82rem; font-size: 0.98rem; }
/* keep the primary CTA legibly itself when idle Ã¢â‚¬â€ a softened accent, not the
   gray "well" disabled slab that reads as broken on first paint */
.auth-submit:disabled, .auth-submit[aria-disabled="true"] {
  background: var(--accent); color: var(--accent-ink);
  border-color: transparent; box-shadow: none; opacity: 0.42;
}

/* error + fine print */
.auth-err { margin: 0.85rem 0 0; padding: 0.7rem 0.9rem; border-radius: var(--r-md); font-size: 0.88rem; font-weight: 500; color: var(--accent-press); background: var(--accent-tint); border: 1px solid oklch(0.86 0.07 40); }
.auth-fine { margin: 1rem 0 0; font-size: 0.8rem; line-height: 1.55; color: var(--ink-3); }
.auth-cross { margin: 1.1rem 0 0; font-size: 0.9rem; color: var(--ink-2); text-align: center; }

/* back link under the card */
.auth-back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.88rem; font-weight: 500; color: var(--ink-3); transition: color .18s ease, gap .18s ease; }
.auth-back svg { width: 16px; height: 16px; }
.auth-back:hover { color: var(--accent); gap: 0.55rem; }

/* sent state */
.auth-sent { display: flex; flex-direction: column; align-items: center; text-align: center; }
.auth-check { width: 56px; height: 56px; border-radius: 50%; background: var(--ok-tint); color: var(--ok); display: grid; place-items: center; margin-bottom: 1rem; animation: pop .5s var(--ease-out) both; }
.auth-check svg { width: 28px; height: 28px; }
.auth-sent .auth-sub { margin-inline: auto; text-align: center; }
.auth-email-echo { color: var(--ink); font-weight: 600; }
.auth-sent-actions { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 1.4rem; width: 100%; }
.auth-sent-actions .btn { --pad-y: 0.82rem; font-size: 0.98rem; }

/* ============================================================
   Legal pages (/privacy) Ã¢â‚¬â€ long-form prose in the studio-light
   furniture. Narrow measure, an accent-ticked header, a quiet
   in-page index, and ruled sections. Reuses the tonal ladder
   and accent tick; no new color, no eyebrow pills.
   ============================================================ */
.legal { padding-top: clamp(2.25rem, 5vw, 4rem); padding-bottom: clamp(3rem, 6vw, 5rem); }
.legal-inner { max-width: 760px; margin-inline: auto; }

.legal-head { position: relative; padding-top: 1.4rem; margin-bottom: clamp(1.75rem, 4vw, 2.75rem); }
.legal-head::before { content: ""; position: absolute; top: 0; left: 0; width: 40px; height: 2px; background: var(--accent); }
.legal-eyebrow { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin: 0; }
.legal-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 5vw, 2.9rem); line-height: 1.02; letter-spacing: -0.03em; color: var(--ink); margin: 0.5rem 0 0; }
.legal-updated { font-size: 0.84rem; color: var(--ink-3); margin: 0.7rem 0 0; }
.legal-lede { font-size: clamp(1.02rem, 1.6vw, 1.15rem); line-height: 1.6; color: var(--ink-2); margin: 1.1rem 0 0; max-width: 60ch; }

/* in-page index */
.legal-toc { display: flex; flex-wrap: wrap; gap: 0.5rem 0.6rem; padding: clamp(1.1rem, 2.4vw, 1.5rem); margin-bottom: clamp(2rem, 4vw, 3rem); background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--r-lg); }
.legal-toc a { font-size: 0.86rem; font-weight: 500; color: var(--ink-2); padding: 0.32rem 0.7rem; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-pill); transition: color .18s ease, border-color .18s ease; }
.legal-toc a:hover { color: var(--accent); border-color: var(--line-2); }

/* sections */
.legal-body { display: grid; gap: clamp(1.75rem, 3.5vw, 2.6rem); }
.legal-section { scroll-margin-top: 96px; }
.legal-section h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.25rem, 2.4vw, 1.5rem); letter-spacing: -0.02em; color: var(--ink); margin: 0 0 0.85rem; }
.legal-section p { font-size: 1rem; line-height: 1.65; color: var(--ink-2); margin: 0 0 0.85rem; max-width: 66ch; }
.legal-section p:last-child { margin-bottom: 0; }
.legal-section ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
.legal-section li { position: relative; padding-left: 1.5rem; font-size: 1rem; line-height: 1.6; color: var(--ink-2); max-width: 66ch; }
.legal-section li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
.legal-section li strong { color: var(--ink); font-weight: 600; }
.legal-section a { color: var(--accent); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--line-2); transition: text-decoration-color .18s ease; }
.legal-section a:hover { text-decoration-color: var(--accent); }

/* ============================================================
   Paul static handoff port: compact app system
   ============================================================ */
:root {
  --colors-semantic-white: var(--card);
  --colors-semantic-neutral-50: var(--paper);
  --colors-semantic-neutral-100: var(--paper-2);
  --colors-semantic-neutral-200: var(--line);
  --colors-semantic-neutral-300: var(--line-2);
  --colors-semantic-neutral-400: var(--ink-3);
  --colors-semantic-neutral-500: var(--ink-2);
  --colors-semantic-neutral-700: var(--ink);
  --colors-semantic-neutral-900: var(--ink);
  --colors-semantic-primary-50: var(--accent-tint);
  --colors-semantic-primary-500: var(--accent);
  --colors-semantic-primary-600: var(--accent-press);
  --colors-semantic-success-100: var(--ok-tint);
  --colors-semantic-success-500: var(--ok);
  --colors-semantic-success-700: #126438;
  --colors-semantic-warning-500: #b7791f;
  --colors-semantic-error-50: var(--accent-tint);
  --colors-semantic-error-500: var(--accent);
  --colors-semantic-error-700: var(--accent-press);
  --spacing-1: 4px;
  --spacing-2: 6px;
  --spacing-3: 8px;
  --spacing-4: 12px;
  --spacing-5: 16px;
  --spacing-6: 24px;
  --spacing-7: 32px;
  --spacing-8: 40px;
  --spacing-9: 48px;
  --radius-1: 4px;
  --radius-2: 6px;
  --radius-3: 8px;
  --radius-4: 999px;
  --size-icon-sm: 14px;
  --size-icon-md: 18px;
  --size-icon-lg: 24px;
  --typography-font-family-text: var(--font-sans);
  --typography-font-family-code: var(--font-mono);
  --typography-font-weight-semibold: 600;
  --typography-font-weight-bold: 700;
  --typography-header-font-size-3: 28px;
  --typography-header-font-size-4: 20px;
  --typography-header-font-size-5: 24px;
  --typography-line-height-5: 1.55;
  --typography-line-height-6: 1.25;
  --typography-paragraph-and-label-font-size-1: 12px;
  --typography-paragraph-and-label-font-size-2: 13px;
  --typography-paragraph-and-label-font-size-4: 16px;
  --typography-label-regular-md: 400 14px/1.4 var(--font-sans);
  --typography-label-bold-md: 700 14px/1.2 var(--font-sans);
  --typography-paragraph-regular-md: 400 16px/1.55 var(--font-sans);
}

.fy-shell {
  max-width: 680px;
  margin: 0 auto;
  padding-inline: var(--spacing-6);
}

.site-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  background: color-mix(in oklab, var(--paper) 92%, transparent);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid transparent;
}

.site-nav.is-scrolled { border-bottom-color: var(--line); }
.site-nav { max-width: 1120px; }
.site-nav-inner { width: 100%; display: flex; flex-wrap: nowrap; align-items: center; gap: var(--spacing-4); min-width: 0; }
.site-nav-links { flex: 1 1 auto; justify-content: center; min-width: 0; flex-wrap: nowrap; }
.site-nav-cta { flex: 0 0 150px; justify-content: flex-end; margin-left: 0; }
.site-nav .pj-btn, .fy-footer a { white-space: nowrap; }
@media (max-width: 860px) {
  .site-nav-inner { flex-wrap: wrap; }
  .site-nav-links { order: 3; width: 100%; justify-content: flex-start; flex-wrap: wrap; }
  .site-nav-cta { flex-basis: auto; margin-left: auto; }
}

.fy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: var(--spacing-5);
}

.fy-wordmark {
  display: inline-flex;
  align-items: center;
  flex: 0 0 130px;
  gap: var(--spacing-2);
  font: var(--typography-label-bold-md);
  font-size: 16px;
  letter-spacing: 0;
  color: var(--ink);
  text-decoration: none;
}

.fy-header__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-1);
  flex-wrap: nowrap;
}

.pj-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  min-height: 34px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: var(--radius-3);
  background: var(--card);
  color: var(--ink);
  font: var(--typography-label-bold-md);
  text-decoration: none;
  white-space: nowrap;
  transition: background .16s ease, border-color .16s ease, color .16s ease;
}

.pj-btn:hover { border-color: var(--line-2); background: var(--paper-2); }
.pj-btn--tertiary { border-color: transparent; background: transparent; color: var(--ink-2); }
.pj-btn--tertiary:hover, .pj-btn.is-active { background: var(--paper-2); color: var(--ink); }
.pj-btn--blue, .pj-btn--primary { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
.pj-btn--blue:hover, .pj-btn--primary:hover { border-color: var(--accent-press); background: var(--accent-press); }
.pj-btn--danger { border-color: var(--accent); color: var(--accent-press); background: var(--accent-tint); }
.pj-btn__label { display: inline; }

.pj-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-3);
  background: var(--card);
}
.pj-card__body { display: flex; flex-direction: column; gap: var(--spacing-4); padding: var(--spacing-6); }
.pj-card__title { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: 0; }
.pj-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
  width: fit-content;
  border-radius: var(--radius-4);
  padding: 3px 8px;
  background: var(--paper-2);
  color: var(--ink-2);
  font: var(--typography-label-bold-md);
  font-size: 12px;
}
.pj-badge--success { background: var(--ok-tint); color: var(--ok); }
.pj-badge--danger { background: var(--accent-tint); color: var(--accent-press); }
.pj-icon { width: var(--pj-icon-size, 16px); height: var(--pj-icon-size, 16px); color: var(--pj-icon-color, currentColor); }

.fy-page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-5);
  padding-block: var(--spacing-9);
}
.fy-page__eyebrow, .fy-eyebrow {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--accent);
}
.fy-page__title {
  margin: 0;
  font-weight: 600;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.1;
  letter-spacing: 0;
}
.fy-page__lead, .fy-section__sub {
  margin: 0;
  max-width: 60ch;
  color: var(--ink-2);
  font: var(--typography-paragraph-regular-md);
}
.fy-page__actions { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-top: var(--spacing-2); }
.fy-section {
  padding-block: var(--spacing-9);
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-6);
}
.fy-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--spacing-3);
  flex-wrap: wrap;
}
.fy-section__title {
  margin: 0;
  font-size: 24px;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: 0;
}
.fy-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-4);
  padding-block: var(--spacing-9);
  border-top: 1px solid var(--line);
  color: var(--ink-3);
  font-size: 12px;
}
.fy-footer nav { display: flex; flex-wrap: wrap; gap: var(--spacing-5); }
.fy-footer a { color: var(--ink-2); text-decoration: none; }
.fy-footer a:hover { color: var(--ink); text-decoration: underline; }

.fy-balance {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-2);
  padding: 6px 12px;
  border-radius: var(--radius-4);
  background: var(--ok-tint);
  color: var(--ok);
  font: var(--typography-label-bold-md);
  white-space: nowrap;
}
.fy-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-5); }
@media (max-width: 640px) { .fy-stats { grid-template-columns: 1fr; } }
.fy-stat__label { margin: 0 0 var(--spacing-2); color: var(--ink-3); font-size: 14px; }
.fy-stat__value { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: 0; }
.fy-stat__hint { margin: var(--spacing-2) 0 0; color: var(--ink-3); font-size: 12px; }

.fy-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-5); align-items: start; }
@media (max-width: 760px) { .fy-board { grid-template-columns: 1fr; } }
.fy-col { display: flex; flex-direction: column; gap: var(--spacing-4); }
.fy-col__head { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-3); }
.fy-col__title { display: inline-flex; align-items: center; gap: var(--spacing-3); font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
.fy-col__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); }
.fy-col__dot--working { background: var(--colors-semantic-warning-500); }
.fy-col__dot--ready { background: var(--ok); }
.fy-col__dot--failed { background: var(--accent); }
.fy-col__count { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); }
.fy-job-card { display: flex; flex-direction: column; gap: var(--spacing-3); padding: var(--spacing-5); border: 1px solid var(--line); border-radius: var(--radius-2); background: var(--card); }
.fy-job-card__name { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fy-job-card__meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); }
.fy-job-card__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-3); flex-wrap: wrap; }
.fy-meter { height: 6px; border-radius: var(--radius-4); background: var(--paper-2); overflow: hidden; }
.fy-meter__fill { height: 100%; border-radius: inherit; background: var(--accent); }
.fy-empty { padding: var(--spacing-6); border: 1px dashed var(--line-2); border-radius: var(--radius-2); text-align: center; color: var(--ink-3); }

.fy-tiers-grid, .fy-rails { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-5); }
@media (max-width: 640px) { .fy-tiers-grid, .fy-rails { grid-template-columns: 1fr; } }
.fy-pack { position: relative; display: flex; flex-direction: column; gap: var(--spacing-3); padding: var(--spacing-6); border: 1px solid var(--line); border-radius: var(--radius-3); background: var(--card); }
.fy-pack--featured { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
.fy-pack__ribbon { position: absolute; top: var(--spacing-5); right: var(--spacing-5); }
.fy-pack__beans, .fy-pack__price { font-size: 28px; font-weight: 700; letter-spacing: 0; }
.fy-pack__note { margin: 0; color: var(--ink-2); font-size: 13px; }
.fy-points { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--spacing-4) var(--spacing-6); }
.fy-points li { display: flex; align-items: center; gap: var(--spacing-3); color: var(--ink-2); font-size: 14px; }

.fy-auth { display: flex; justify-content: center; padding-block: var(--spacing-9); }
.fy-auth__card { width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: var(--spacing-5); padding: var(--spacing-8); border: 1px solid var(--line); border-radius: var(--radius-3); background: var(--card); box-shadow: var(--sh-sm); }
.fy-auth__title { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: 0; }
.fy-auth__sub, .fy-auth__foot { margin: 0; color: var(--ink-2); font-size: 13px; }
.fy-auth__divider { display: flex; align-items: center; gap: var(--spacing-4); color: var(--ink-3); font-size: 12px; }
.fy-auth__divider::before, .fy-auth__divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }
.fy-btn--block { width: 100%; justify-content: center; }

/* Keep existing functional pages, but put them on the static handoff's compact rail. */
.addon .wrap,
.api .wrap,
.topup .wrap,
.ws .wrap,
.acct .wrap {
  width: min(680px, 100% - 48px);
  max-width: 680px;
}

.addon-hero,
.topup-hero {
  padding-block: var(--spacing-9);
}

.addon-hero-grid,
.topup-hero-grid {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
}

.addon-hero-copy,
.topup-hero-copy,
.addon-launch,
.topup-composer-wrap {
  max-width: none;
}

.addon .h1,
.api .h1,
.topup .h1,
.ws-title,
.acct .ws-title {
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.1;
  letter-spacing: 0;
}

.addon .lede,
.api .lede,
.topup .lede,
.ws-sub {
  max-width: 60ch;
  font-size: 16px;
}

.section-title,
.addon-final-title,
.topup-composer-title,
.acct-card-title {
  letter-spacing: 0;
}

.ws {
  background: var(--card);
}

.ws-head,
.acct-head {
  padding-block: var(--spacing-9);
}

.ws-spotlight,
.ws-block,
.ws-empty,
.acct-card,
.topup-composer,
.addon-shot,
.addon-pair-card,
.addon-where,
.api-endpoint,
.api-note,
.api-resp,
.api-roadmap-item,
.topup-rail {
  border-radius: var(--radius-3);
}

/* Paul farpy.html homepage */
.fy-hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--spacing-7);
  padding-block: var(--spacing-9);
}
.fy-hero__copy {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-5);
  text-align: center;
}
.fy-h1 {
  margin: 0;
  font-weight: 600;
  font-size: clamp(34px, 6vw, 52px);
  line-height: 1.1;
  letter-spacing: 0;
}
.fy-hero__sub {
  margin: 0 auto;
  max-width: 44ch;
  font: var(--typography-paragraph-regular-md);
  color: var(--ink-2);
}
.pj-dropzone {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px dashed var(--line-2);
  background: var(--paper);
  cursor: pointer;
  text-align: center;
  transition: border-color .16s ease, background .16s ease;
}
.pj-dropzone:hover { border-color: var(--accent); background: var(--accent-tint); }
.pj-dropzone__input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}
.fy-drop {
  flex-direction: column;
  gap: var(--spacing-5);
  min-height: 340px;
  border-radius: var(--radius-3);
  padding: var(--spacing-9);
}
.fy-drop-compact {
  min-height: 220px;
  padding: var(--spacing-7);
}
.fy-drop .pj-dropzone__icon {
  --pj-icon-size: 40px;
}
.fy-drop__title {
  margin: 0;
  font-size: 20px;
  line-height: 1.25;
  font-weight: 600;
}
.fy-drop__hint {
  margin: 0;
  font-size: 13px;
  color: var(--ink-2);
}
.fy-trust {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--spacing-3) var(--spacing-6);
  margin: 0;
  padding: 0;
  list-style: none;
}
.fy-trust li {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-3);
  font-size: 13px;
  color: var(--ink-2);
}
.fy-trust .pj-icon,
.fy-points .pj-icon {
  --pj-icon-size: var(--size-icon-sm);
  --pj-icon-color: var(--ok);
  position: relative;
  flex: none;
}
.fy-trust .pj-icon::before,
.fy-points .pj-icon::before {
  content: "";
  display: block;
  width: var(--pj-icon-size, 16px);
  height: var(--pj-icon-size, 16px);
  border-radius: 50%;
  background: var(--ok);
  box-shadow: inset 0 0 0 4px var(--ok-tint);
}
.fy-privacy__body {
  flex-direction: row;
  align-items: center;
  gap: var(--spacing-4);
}
.fy-privacy__text {
  margin: 0;
  color: var(--ink-2);
}
.fy-privacy__text strong {
  color: var(--ink);
  font-weight: 600;
}
.fy-job { width: 100%; }
.fy-file {
  display: flex;
  align-items: center;
  gap: var(--spacing-4);
  width: 100%;
  min-width: 0;
}
.fy-file__meta {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-1);
  min-width: 0;
}
.fy-file__name {
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fy-file__size {
  font-size: 12px;
  color: var(--ink-2);
}
.fy-file__change { margin-left: auto; }
.fy-tiers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-4);
  width: 100%;
}
@media (max-width: 540px) { .fy-tiers { grid-template-columns: 1fr; } }
.fy-tier {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-4);
  padding: var(--spacing-5);
  border: 1px solid var(--line);
  border-radius: var(--radius-2);
  cursor: pointer;
}
.fy-tier:hover,
.fy-tier:has(.pj-radio:checked) {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 1px var(--accent);
}
.fy-tier__text {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-1);
}
.fy-tier__name { font-weight: 700; }
.fy-tier__desc {
  font-size: 12px;
  color: var(--ink-2);
}
.fy-tier__price {
  margin-top: var(--spacing-2);
  font-family: var(--font-mono);
  font-size: 12px;
}
.fy-progress {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-3);
  width: 100%;
}
.fy-progress__track {
  width: 100%;
  height: 8px;
  border-radius: var(--radius-4);
  background: var(--paper-2);
  overflow: hidden;
}
.fy-progress__fill {
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width .3s ease;
}
.fy-progress__row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: var(--ink-2);
}
.fy-progress__row strong { color: var(--ink); }
.fy-receipt {
  width: 100%;
  padding: var(--spacing-5);
  border: 1px dashed var(--line);
