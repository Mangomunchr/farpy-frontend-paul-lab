.faq-aside-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.95rem; font-weight: 600; font-size: 0.92rem; color: var(--accent); transition: gap .18s ease; }
.faq-aside-link:hover { gap: 0.62rem; }
.faq-aside-link svg { width: 15px; height: 15px; }

/* ---------- final cta Ã¢â‚¬â€ large render-farm photo, scrimmed, + warm spotlight ---------- */
.final-cta {
  position: relative; isolation: isolate; overflow: hidden;
  display: flex; flex-direction: column; justify-content: center;
  min-height: clamp(440px, 56vh, 620px);
  border-radius: var(--r-xl); background: var(--ink); text-align: center;
  padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 5vw, 3rem);
  box-shadow: var(--sh-lg);
}
/* the high-res GPU-farm photo, cover-filling the slab; toned down a touch so it
   reads as backdrop, not subject */
.final-cta-bg {
  position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%;
  object-fit: cover; filter: saturate(0.78) brightness(0.62) contrast(1.05);
}
/* legibility scrim Ã¢â‚¬â€ a strong dark veil (the photo's a backdrop, the copy is the
   subject) with a little extra weight top & bottom where title / fine print sit */
.final-cta::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background:
    linear-gradient(180deg, oklch(0.10 0.012 262 / 0.90), oklch(0.11 0.012 262 / 0.74) 50%, oklch(0.08 0.012 262 / 0.94));
}
.final-cta::after {
  content: ""; position: absolute; z-index: -1; pointer-events: none;
  top: -55%; left: 50%; transform: translateX(-50%);
  width: min(720px, 92%); aspect-ratio: 1;
  background: radial-gradient(circle, oklch(0.635 0.198 33 / 0.26), transparent 60%);
}
.final-cta-title {
  margin: 0 auto; max-width: 16ch;
  font-family: var(--font-display); font-weight: 700;
  font-size: clamp(2rem, 4.6vw, 3rem); line-height: 1.04; letter-spacing: -0.026em; word-spacing: 0.06em;
  color: var(--paper); text-wrap: balance;
}
.final-cta-lede {
  margin: 1.1rem auto 0; max-width: 46ch;
  font-size: clamp(1.02rem, 1.5vw, 1.18rem); line-height: 1.55;
  color: oklch(0.93 0.008 80 / 0.82);
}
.final-cta-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; margin-top: clamp(1.75rem, 3vw, 2.25rem); }
.final-cta-fine { margin: clamp(1.4rem, 2.5vw, 1.9rem) auto 0; font-size: 0.8rem; line-height: 1.5; color: oklch(0.9 0.008 80 / 0.72); }

html { scroll-behavior: smooth; }

/* ============================================================
   How it works Ã¢â‚¬â€ render pipeline (no cards; ruled track +
   registration ticks + oversized mono station numerals)
   ============================================================ */
.section-head { max-width: 54ch; }
.section-title {
  font-family: var(--font-display); font-weight: 700;
  font-size: clamp(2.1rem, 4.6vw, 3.3rem); line-height: 1.03; letter-spacing: -0.03em; word-spacing: 0.06em;
  color: var(--ink); margin: 0; text-wrap: balance;
}
.section-lede { font-size: clamp(1.02rem, 1.5vw, 1.18rem); color: var(--ink-2); margin: 1rem 0 0; max-width: 46ch; }

.pipeline { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: clamp(2.25rem, 4.5vw, 3.5rem); }
.step { position: relative; border-top: 1px solid var(--line); padding-top: 1.4rem; }
.step + .step { margin-top: 1.75rem; }
.step::before { content: ""; position: absolute; top: -1px; left: 0; width: 34px; height: 2px; background: var(--accent); border-radius: 1px; }
.step-index {
  display: block; font-family: var(--font-mono); font-weight: 500;
  font-size: clamp(2rem, 3.6vw, 2.85rem); line-height: 1; letter-spacing: -0.04em;
  color: var(--ink-3); font-feature-settings: "tnum" 1;
}
.step-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.12rem, 1.4vw, 1.22rem); letter-spacing: -0.012em; color: var(--ink); margin: 0.95rem 0 0.45rem; }
.step-desc { font-size: 0.93rem; line-height: 1.55; color: var(--ink-2); margin: 0; max-width: 32ch; }
@media (min-width: 880px) {
  /* one continuous track; each step hangs an accent registration tick off it */
  .pipeline { grid-template-columns: repeat(4, 1fr); column-gap: clamp(1.5rem, 3vw, 3rem); padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .step { border-top: 0; padding-top: 0; padding-inline-end: clamp(0.5rem, 1.5vw, 1.5rem); }
  .step + .step { margin-top: 0; }
  .step::before { top: calc(-1.5rem - 1px); }
}

/* ---------- trust band Ã¢â‚¬â€ quiet ruled items; the accent tick is reserved for the
   pipeline + signature artifacts (widget, receipt), not repeated here ---------- */
.trust-item { position: relative; padding-top: 1.4rem; border-top: 1px solid var(--line-2); }

/* split: promises on the left, a real render you can open on the right */
.trust-split { display: grid; gap: clamp(2.25rem, 4vw, 3.5rem); align-items: stretch; }
@media (min-width: 940px) { .trust-split { grid-template-columns: 1.05fr 0.95fr; } }
.trust-copy { display: flex; flex-direction: column; }
.trust-grid { margin-top: clamp(1.75rem, 3vw, 2.5rem); display: grid; gap: clamp(1.6rem, 3vw, 2.1rem) clamp(1.5rem, 3vw, 2rem); }
@media (min-width: 520px) { .trust-grid { grid-template-columns: 1fr 1fr; } }

/* the framed render Ã¢â‚¬â€ clicks through to the verified receipt */
.trust-render { position: relative; display: block; color: inherit; }
.trust-render-frame {
  position: relative; display: block; overflow: hidden;
  height: 100%; min-height: clamp(360px, 46vw, 520px);
  border: 1px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--sh-lg); background: var(--well);
  transition: border-color .25s ease, box-shadow .25s ease;
}
.trust-render-frame img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transform: scale(1.03); will-change: transform;
  animation: breathe 24s ease-in-out infinite alternate;
}
.trust-render:hover .trust-render-frame { border-color: var(--accent); box-shadow: var(--sh-lg), 0 0 0 1px var(--accent); }

/* "Verified" status chip, top-right (reuses the viewport HUD language) */
.trust-live {
  position: absolute; top: clamp(0.7rem, 1.6vw, 1.05rem); right: clamp(0.7rem, 1.6vw, 1.05rem); z-index: 2;
  display: inline-flex; align-items: center; gap: 0.45rem;
  font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; color: var(--ink-2);
  background: var(--card); border: 1px solid var(--line); padding: 0.32rem 0.62rem; border-radius: var(--r-pill); box-shadow: var(--sh-sm);
}

/* floating receipt card Ã¢â‚¬â€ the proof, made tangible */
.trust-receipt {
  position: absolute; left: clamp(0.85rem, 2vw, 1.15rem); right: clamp(0.85rem, 2vw, 1.15rem); bottom: clamp(0.85rem, 2vw, 1.15rem); z-index: 2;
  display: grid; gap: 0.42rem;
  background: var(--card); border: 1px solid var(--line); border-radius: var(--r-md); box-shadow: var(--sh-md);
  padding: 0.78rem 0.9rem; transition: transform .25s var(--ease-out);
}
.trust-render:hover .trust-receipt { transform: translateY(-3px); }
.trust-receipt-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
.trust-receipt-name { font-family: var(--font-display); font-weight: 600; font-size: 0.96rem; color: var(--ink); }
.trust-receipt-check { display: inline-flex; align-items: center; gap: 0.32rem; font-size: 0.72rem; font-weight: 600; color: oklch(0.5 0.13 150); }
.trust-receipt-check svg { width: 13px; height: 13px; }
.trust-receipt-scene { font-size: 0.75rem; color: var(--ink-3); }
.trust-receipt-line { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; padding-top: 0.45rem; border-top: 1px dashed var(--line-2); }
.trust-receipt-line span { font-size: 0.8rem; color: var(--ink-2); }
.trust-receipt-line b { font-size: 1rem; color: var(--ink); }

/* ---------- GPU hardware hero (How it works, step 03) ---------- */
.gpu-figure { position: relative; margin: clamp(2rem, 4vw, 3.25rem) 0 0; }

/* both media figures stay contained at the .wrap width Ã¢â‚¬â€ equal gutters on both
   sides, matching the steps + caption text column rather than bleeding off-edge.
   On desktop, drop the aspect-ratio + 72vh cap (which would shrink the frame
