}

/* endpoint list Ã¢â‚¬â€ each row is the method, the path, and a plain-language line */
.api-endpoints { list-style: none; margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; display: grid; gap: 0.85rem; }
.api-endpoint { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1rem, 2vw, 1.3rem) clamp(1.1rem, 2.2vw, 1.5rem); box-shadow: var(--sh-sm); transition: border-color .2s ease, box-shadow .2s ease; }
