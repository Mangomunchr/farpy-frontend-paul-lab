.faq-chevron { transition: transform .25s var(--ease-out); }
.faq-item:hover .faq-chevron { color: var(--ink-2); }
.faq-item[open] .faq-chevron { transform: rotate(180deg); }
.faq-answer { margin: 0; padding: 0 clamp(0rem, 3vw, 2.5rem) 1.4rem 1.85rem; max-width: 66ch; font-size: 0.96rem; line-height: 1.62; color: var(--ink-2); }

/* smooth height + fade reveal; everything below shifts gradually instead of snapping */
.faq-item::details-content {
  block-size: 0;
  overflow: clip;
  opacity: 0;
  transition:
    block-size .34s var(--ease-out),
    opacity .26s ease,
    content-visibility .34s allow-discrete;
}
.faq-item[open]::details-content {
  block-size: auto;
  opacity: 1;
}
@media (prefers-reduced-motion: reduce) {
  .faq-item::details-content { transition: none; }
}

/* faq support card (fills the heading column, nudges to a free quote) */
.faq-aside { margin-top: clamp(2rem, 4vw, 2.75rem); padding: clamp(1.25rem, 2.5vw, 1.6rem); background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-sm); }
.faq-aside-q { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 1.04rem; color: var(--ink); }
