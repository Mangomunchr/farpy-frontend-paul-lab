/* device (add-on) */
.acct-device { display: flex; align-items: center; gap: 0.85rem; padding: 0.95rem 1.05rem; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--well); }
.acct-device-empty { background: var(--paper-2); }
