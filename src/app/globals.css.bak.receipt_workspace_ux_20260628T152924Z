.ws-composer::before { content: ""; position: absolute; top: -1px; left: clamp(1.3rem, 2.6vw, 2rem); width: 40px; height: 2px; background: var(--accent); }
.ws-composer .file-row { padding-bottom: 1rem; }
.ws-composer-body { display: grid; gap: clamp(1.3rem, 3vw, 2.5rem); margin: 1.1rem 0 1.35rem; }
@media (min-width: 720px) { .ws-composer-body { grid-template-columns: 1fr 1fr; align-items: start; } }
.ws-queue { display: grid; gap: 0.75rem; align-content: start; }
.ws-queue-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
.ws-queue-label { font-size: 0.95rem; font-weight: 500; color: var(--ink-2); }
.ws-queue-hint { margin: 0; font-size: 0.82rem; color: var(--ink-3); }

/* dropzone (composer idle state), reusing .blend-token + brackets */
.ws-drop {
  position: relative; display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 1.4rem);
  border-radius: var(--r-lg); background: var(--card); cursor: pointer; overflow: hidden;
  box-shadow: inset 0 0 0 1px var(--line), var(--sh-sm);
  transition: background .2s ease, box-shadow .2s ease;
}
.ws-drop:hover { background: var(--paper-2); }
.ws-drop:hover .blend-token { transform: translateY(-3px) rotate(-3.5deg); box-shadow: var(--sh-md); }
.ws-drop.is-drag { background: var(--accent-tint); box-shadow: inset 0 0 0 1.5px var(--accent); }
.ws-drop .blend-token { flex: none; }
.ws-drop-copy { display: flex; flex-direction: column; gap: 0.18rem; min-width: 0; }
.ws-drop-title { font-weight: 600; font-size: clamp(0.98rem, 1.4vw, 1.08rem); color: var(--ink); }
.ws-drop-title code { font-size: 0.88em; }
.ws-drop-hint { font-size: 0.8rem; color: var(--ink-3); }
.ws-drop-btn { flex: none; pointer-events: none; }

/* big variant Ã¢â‚¬â€ the prominent composer dropzone */
.ws-drop-big { flex-direction: column; text-align: center; gap: 1.05rem; padding: clamp(2rem, 5vw, 3.5rem); background: var(--paper); }
.ws-drop-big:hover { background: var(--paper-2); }
.ws-drop-big .blend-token { width: 56px; height: 68px; }
.ws-drop-big .ws-drop-copy { align-items: center; }

/* corner registration brackets (shared with the big dropzone + live tiles) */
.ws-corners i { position: absolute; width: 16px; height: 16px; border: 2px solid var(--line-2); transition: border-color .2s ease; }
.ws-corners i:nth-child(1) { top: 12px; left: 12px; border-right: 0; border-bottom: 0; border-top-left-radius: 5px; }
.ws-corners i:nth-child(2) { top: 12px; right: 12px; border-left: 0; border-bottom: 0; border-top-right-radius: 5px; }
.ws-corners i:nth-child(3) { bottom: 12px; left: 12px; border-right: 0; border-top: 0; border-bottom-left-radius: 5px; }
.ws-corners i:nth-child(4) { bottom: 12px; right: 12px; border-left: 0; border-top: 0; border-bottom-right-radius: 5px; }
.ws-drop.is-drag .ws-corners i { border-color: var(--accent); }

/* notice under the bar (file error / insufficient balance) */
.ws-notice { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; margin-top: 0.85rem; padding: 0.7rem 0.95rem; border-radius: var(--r-md); font-size: 0.9rem; font-weight: 500; }
.ws-notice span { flex: 1; min-width: 12ch; }
.ws-notice-error { color: var(--accent-press); background: var(--accent-tint); border: 1px solid oklch(0.86 0.07 40); }
.ws-notice-info { color: var(--ink-2); background: var(--well); border: 1px solid var(--line); }

/* first-run empty state Ã¢â‚¬â€ a quiet, left-aligned helper row. Deliberately NOT a
   second big centered card, so it reads as a secondary note rather than mirroring
   the dropzone above it. */
.ws-empty { margin-top: clamp(1.4rem, 3vw, 2.2rem); display: flex; align-items: flex-start; gap: clamp(0.9rem, 2vw, 1.25rem); padding: clamp(1.1rem, 2.4vw, 1.5rem) clamp(1.15rem, 2.4vw, 1.6rem); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--well); }
.ws-empty-icon { width: 42px; height: 42px; flex: none; display: grid; place-items: center; border-radius: var(--r-md); background: var(--card); border: 1px solid var(--line); color: var(--ink-3); box-shadow: var(--sh-sm); }
.ws-empty-icon svg { width: 22px; height: 22px; }
.ws-empty-text { display: flex; flex-direction: column; gap: 0.28rem; min-width: 0; }
.ws-empty-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.05rem, 1.8vw, 1.2rem); letter-spacing: -0.015em; color: var(--ink); margin: 0; }
.ws-empty-sub { font-size: 0.93rem; color: var(--ink-2); margin: 0; max-width: 62ch; }
.ws-empty-addon { font-size: 0.9rem; color: var(--ink-3); margin: 0.4rem 0 0; }
.ws-empty-link { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 600; color: var(--accent); }
.ws-empty-link svg { width: 15px; height: 15px; transition: transform .18s ease; }
.ws-empty-link:hover svg { transform: translateX(3px); }

/* render sections (active + recent) */
.ws-block { margin-top: clamp(2.4rem, 5vw, 3.5rem); }
.ws-block-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; flex-wrap: wrap; margin-bottom: clamp(1.2rem, 2.5vw, 1.75rem); }
.ws-h2 { display: inline-flex; align-items: center; gap: 0.55rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 2.4vw, 1.7rem); letter-spacing: -0.02em; color: var(--ink); margin: 0; }

.ws-grid { display: grid; gap: clamp(1.1rem, 2.4vw, 1.6rem); grid-template-columns: repeat(auto-fill, minmax(248px, 1fr)); }

.ws-card { display: flex; flex-direction: column; }
a.ws-card { color: inherit; }
a.ws-card .ws-frame { transition: box-shadow .2s ease, border-color .2s ease; }
a.ws-card:hover .ws-frame { border-color: var(--accent); box-shadow: var(--sh-md); }
.ws-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--sh-sm); background: var(--well); }
.ws-frame img { width: 100%; height: 100%; object-fit: cover; }
.ws-verify { position: absolute; top: 0.6rem; right: 0.6rem; display: inline-flex; align-items: center; gap: 0.3rem; background: oklch(0.22 0.02 62 / 0.78); color: white; font-size: 0.68rem; font-weight: 600; padding: 0.24rem 0.5rem 0.24rem 0.4rem; border-radius: var(--r-pill); backdrop-filter: blur(4px); }
.ws-verify svg { width: 11px; height: 11px; color: oklch(0.82 0.14 150); }

/* live tile Ã¢â‚¬â€ recessed viewport surface that renders itself */
.ws-live { background:
  linear-gradient(to right, oklch(0.50 0.005 255 / 0.10) 1px, transparent 1px) 0 0 / 30px 30px,
  linear-gradient(to bottom, oklch(0.50 0.005 255 / 0.10) 1px, transparent 1px) 0 0 / 30px 30px,
  var(--well);
  display: grid; place-items: center;
  box-shadow: inset 0 0 0 1px var(--line), inset 0 2px 8px oklch(0.26 0.02 62 / 0.06);
}
/* progressive render reveal Ã¢â‚¬â€ the finished frame materializes downward as
   frames complete (driven by --p = % done) instead of a looping scan glow.
   Above the render head the image is resolved; below it, the unrendered well. */
.ws-reveal { position: absolute; inset: 0; z-index: 0; }
.ws-reveal img { width: 100%; height: 100%; object-fit: cover; display: block;
  -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 calc(var(--p, 0%) - 14px), transparent var(--p, 0%));
          mask-image: linear-gradient(to bottom, #000 0, #000 calc(var(--p, 0%) - 14px), transparent var(--p, 0%));
  transition: -webkit-mask-image .35s linear, mask-image .35s linear; }
/* the render head: a single crisp line at the resolved boundary Ã¢â‚¬â€ no glow */
.ws-renderhead { position: absolute; left: 0; right: 0; top: var(--p, 0%); z-index: 1; height: 0; pointer-events: none;
  border-top: 1.5px solid var(--accent); box-shadow: 0 -1px 0 oklch(1 0 0 / 0.45); transition: top .35s linear; }
.ws-live-counter { position: relative; z-index: 1; font-size: 0.82rem; font-weight: 500; color: var(--ink-2); background: var(--card); border: 1px solid var(--line); padding: 0.3rem 0.62rem; border-radius: var(--r-pill); box-shadow: var(--sh-sm); }
@media (prefers-reduced-motion: reduce) { .ws-reveal img, .ws-renderhead { transition: none; } }

.ws-card-body { padding-top: 0.7rem; display: flex; flex-direction: column; gap: 0.5rem; }
.ws-card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; }
.ws-card-name { font-weight: 600; font-size: 0.96rem; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ws-card-cost { font-size: 0.86rem; color: var(--ink-2); white-space: nowrap; }
.ws-card-meta { font-size: 0.78rem; color: var(--ink-3); margin: 0; }
.ws-live-tag { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.74rem; font-weight: 600; color: var(--accent-press); white-space: nowrap; }
.ws-live-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); animation: vpPulse 1.4s var(--ease-out) infinite; }
@media (prefers-reduced-motion: reduce) { .ws-live-dot { animation: none; } }

.ws-progress { height: 7px; border-radius: 4px; background: var(--well); box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; }
.ws-progress-bar { height: 100%; border-radius: 4px; background: var(--accent); transition: width .2s linear; }

.ws-card-actions { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.2rem; }
.ws-card-actions .btn-sm svg { width: 15px; height: 15px; }
.ws-receipt-link { font-size: 0.85rem; font-weight: 600; color: var(--ink-2); text-underline-offset: 3px; transition: color .18s ease; }
.ws-receipt-link:hover { color: var(--accent); text-decoration: underline; }

/* ============================================================
   Render detail Ã¢â‚¬â€ the live job page (/workspace/[id])
   ============================================================ */
.rd { padding-top: clamp(1.4rem, 3vw, 2.2rem); }
.rd-grid { display: grid; gap: clamp(1.5rem, 3.5vw, 2.75rem); align-items: start; }
@media (min-width: 900px) { .rd-grid { grid-template-columns: 1.5fr 1fr; } }

.rd-viewport { position: relative; border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--sh-md); background: var(--well); }
.rd-stage { position: relative; width: 100%; aspect-ratio: 16 / 10; }
.rd-done-media { margin: 0; }
.rd-done-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

.rd-hud { position: absolute; inset: 0; z-index: 1; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(0.9rem, 2vw, 1.4rem); }
.rd-hud-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
.rd-hud-tag, .rd-hud-meta { font-family: var(--font-mono); font-size: 0.74rem; background: var(--card); border: 1px solid var(--line); padding: 0.34rem 0.65rem; border-radius: var(--r-pill); box-shadow: var(--sh-sm); }
.rd-hud-tag { display: inline-flex; align-items: center; gap: 0.45rem; font-weight: 600; color: var(--ink-2); }
.rd-hud-meta { color: var(--ink-2); white-space: nowrap; }
.rd-hud-bottom { display: grid; gap: 0.55rem; }
.rd-hud-bottom .ws-progress { background: var(--card); box-shadow: inset 0 0 0 1px var(--line); }
.rd-hud-bottom .rd-hud-meta { justify-self: start; }

.rd-side { position: sticky; top: 88px; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-md); padding: clamp(1.3rem, 2.5vw, 1.9rem); }
@media (max-width: 900px) { .rd-side { position: static; } }
.rd-status-badge { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.74rem; font-weight: 600; color: var(--accent-press); background: var(--accent-tint); padding: 0.26rem 0.58rem; border-radius: var(--r-pill); flex: none; }

.rd-steps { list-style: none; margin: 1.3rem 0 0; padding: 0; display: grid; gap: 0.85rem; }
.rd-steps li { display: flex; align-items: center; gap: 0.7rem; font-size: 0.94rem; color: var(--ink-3); }
.rd-steps li[data-st="done"] { color: var(--ink); }
.rd-steps li[data-st="active"] { color: var(--ink); font-weight: 600; }
.rd-step-mark { width: 20px; height: 20px; flex: none; display: grid; place-items: center; }
.rd-step-mark svg { width: 18px; height: 18px; color: var(--ok); }
.rd-pending-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); }
.rd-spin { width: 15px; height: 15px; border-radius: 50%; border: 2px solid var(--accent-tint); border-top-color: var(--accent); animation: spin 0.8s linear infinite; }

/* one-shot completion flourish: the finished frame resolves out of the render,
   the verified marks pop in once. Not a looping ping Ã¢â‚¬â€ fires a single time. */
.rd.is-fresh .rd-done-media img { animation: rdResolve 0.75s var(--ease-out) both; }
.rd.is-fresh .proofpage-tag { animation: rdPop 0.5s 0.28s var(--ease-out) both; }
.rd.is-fresh .pr2-badge { animation: rdPop 0.5s 0.36s var(--ease-out) both; }
.rd.is-fresh .pr2-amount { animation: rdRise 0.55s 0.3s var(--ease-out) both; }
@keyframes rdResolve {
  from { opacity: 0.25; filter: blur(9px) saturate(0.7); transform: scale(1.035); }
  to { opacity: 1; filter: none; transform: none; }
}
@keyframes rdPop {
  0% { opacity: 0; transform: scale(0.6) translateY(4px); }
  60% { transform: scale(1.08); }
  100% { opacity: 1; transform: none; }
}
@keyframes rdRise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.rd-total { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.3rem; padding-top: 1.1rem; border-top: 1px dashed var(--line-2); }
.rd-total > span:first-child { font-weight: 600; color: var(--ink); }
.rd-total .mono { font-size: 1.1rem; color: var(--ink); }
.rd-total-label { display: flex; flex-direction: column; gap: 0.16rem; }
.rd-total-label small { font-family: var(--font-mono); font-size: 0.73rem; font-weight: 400; color: var(--ink-3); }

/* finished render Ã¢â‚¬â€ the deliverable: what's in the archive + the action */
.rd-deliver { margin-top: 1.4rem; padding: 0.95rem 1rem; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--well); display: grid; gap: 0.9rem; }
.rd-deliver-file { display: flex; align-items: center; gap: 0.7rem; min-width: 0; }
.rd-deliver-icon { width: 36px; height: 36px; flex: none; border-radius: var(--r-sm); background: var(--card); border: 1px solid var(--line); display: grid; place-items: center; color: var(--ink-3); box-shadow: var(--sh-sm); }
.rd-deliver-icon svg { width: 18px; height: 18px; }
.rd-deliver-text { display: flex; flex-direction: column; gap: 0.14rem; min-width: 0; }
.rd-deliver-text b { font-size: 0.85rem; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rd-deliver-text small { font-size: 0.76rem; color: var(--ink-3); }
.rd-deliver .btn svg { width: 17px; height: 17px; }

.rd-secondary { display: flex; flex-wrap: wrap; gap: 0.4rem 1.3rem; margin-top: 1.1rem; }
.rd-missing { padding: clamp(2.5rem, 7vw, 5rem) 0; max-width: 52ch; }
.rd-missing .btn { margin-top: 1.5rem; }

/* ============================================================
   Blender add-on page (/addon) Ã¢â‚¬â€ the second front door.
   Reuses .h1 / .lede / .assure / .section-* / .pipeline / .btn.
   ============================================================ */
.addon-hero { padding-top: clamp(2.25rem, 5vw, 4rem); padding-bottom: clamp(2.5rem, 5vw, 3.5rem); }
.addon-hero-grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
@media (min-width: 880px) {
  .addon-hero-grid { grid-template-columns: 1.05fr 0.95fr; align-items: stretch; }
  .addon-hero-copy { display: flex; flex-direction: column; justify-content: center; }
}

/* launch column: add-on preview + a single, centered download CTA */
.addon-launch { display: flex; flex-direction: column; justify-content: center; gap: clamp(1.4rem, 3vw, 2rem); height: 100%; }

/* preview frame Ã¢â‚¬â€ a window mock holding the real screenshot (or a placeholder) */
.addon-shot { margin: 0; border: 1px solid var(--line); border-radius: var(--r-xl); overflow: hidden; background: var(--card); box-shadow: var(--sh-lg); }
.addon-shot-bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 0.95rem; border-bottom: 1px solid var(--line); background: var(--paper-2); }
.addon-shot-dots { display: inline-flex; gap: 0.4rem; }
.addon-shot-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
.addon-shot-name { font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-3); }
.addon-shot-media { position: relative; aspect-ratio: 4 / 3; background:
  linear-gradient(to right, oklch(0.50 0.005 255 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
  linear-gradient(to bottom, oklch(0.50 0.005 255 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px,
  var(--well); }
.addon-shot-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.addon-shot-ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 0.4rem; padding: 1.5rem; }
.addon-shot-ph-icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: var(--r-md); background: var(--card); border: 1px solid var(--line); color: var(--ink-3); box-shadow: var(--sh-sm); }
.addon-shot-ph-icon svg { width: 26px; height: 26px; }
.addon-shot-ph-title { margin-top: 0.3rem; font-weight: 600; font-size: 0.96rem; color: var(--ink-2); }
.addon-shot-ph-sub { font-size: 0.82rem; color: var(--ink-3); max-width: 28ch; }

.addon-launch-cta { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
.addon-dl { --pad-y: 0.92rem; --pad-x: 1.7rem; font-size: 1rem; }
.addon-dl svg { width: 18px; height: 18px; }
.addon-launch-note { font-size: 0.82rem; color: var(--ink-3); margin: 0; }

/* pair section */
.addon-pair-grid { display: grid; gap: clamp(1.5rem, 3.5vw, 2.75rem); margin-top: clamp(2rem, 4vw, 3rem); align-items: start; }
@media (min-width: 820px) { .addon-pair-grid { grid-template-columns: 1.1fr 0.9fr; } }
.addon-pair-card { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-md); padding: clamp(1.4rem, 3vw, 2rem); display: flex; flex-direction: column; gap: 0.85rem; }
.addon-field-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }
.addon-input { width: 100%; font-size: clamp(1.2rem, 3vw, 1.55rem); font-weight: 600; letter-spacing: 0.4em; text-indent: 0.4em; text-align: center; text-transform: uppercase; color: var(--ink); background: var(--well); border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 0.85rem 0.6rem; box-shadow: inset 0 1px 2px oklch(0.26 0.02 62 / 0.05); transition: border-color .18s ease, box-shadow .18s ease; }
.addon-input::placeholder { color: var(--line-2); }
.addon-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); }
.addon-pair-hint { font-size: 0.82rem; color: var(--ink-3); margin: 0; text-align: center; }

/* paired success */
.addon-paired { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: 0.6rem 0; }
.addon-paired-mark { width: 52px; height: 52px; border-radius: 50%; background: var(--ok-tint); color: var(--ok); display: grid; place-items: center; margin-bottom: 0.4rem; animation: pop .5s var(--ease-out) both; }
.addon-paired-mark .check-ico { width: 26px; height: 26px; }
.addon-paired-title { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.015em; color: var(--ink); margin: 0; }
.addon-paired-sub { font-size: 0.94rem; color: var(--ink-2); margin: 0; max-width: 36ch; }

/* where the code appears */
.addon-where { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.4rem, 3vw, 2rem); }
.addon-where-title { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 1.1rem; }
.addon-where-list { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
.addon-where-list li { counter-increment: step; position: relative; padding-left: 2.3rem; font-size: 0.94rem; color: var(--ink-2); line-height: 1.5; }
.addon-where-list li::before { content: counter(step); position: absolute; left: 0; top: -0.1rem; width: 1.65rem; height: 1.65rem; display: grid; place-items: center; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--accent-press); background: var(--accent-tint); border-radius: 50%; }

/* closing CTA Ã¢â‚¬â€ single focused next step */
.addon-final-inner { display: flex; align-items: center; justify-content: space-between; gap: clamp(1.2rem, 3vw, 2.5rem); flex-wrap: wrap; padding-top: clamp(2.6rem, 5vw, 3.6rem); padding-bottom: clamp(2.6rem, 5vw, 3.6rem); }
.addon-final-copy { display: grid; gap: 0.5rem; }
.addon-final-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2.1rem); letter-spacing: -0.025em; color: var(--ink); margin: 0; }
