.api-path { font-family: var(--font-mono); font-size: clamp(0.86rem, 1.2vw, 0.98rem); background: none; padding: 0; color: var(--ink); }
.api-var { color: var(--accent-press); }
.api-endpoint-desc { margin: 0.6rem 0 0; font-size: 0.93rem; color: var(--ink-2); max-width: 64ch; }
.api-endpoint-req { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: 0.8rem; background: var(--well); border: 1px solid var(--line); border-radius: var(--r-sm); padding: 0.4rem 0.4rem 0.4rem 0.7rem; }
.api-endpoint-req code { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-2); background: none; padding: 0; min-width: 0; overflow-x: auto; white-space: pre; }
.api-link { color: var(--accent); font-weight: 500; text-decoration: underline; text-underline-offset: 2px; text-decoration-color: var(--line-2); transition: text-decoration-color .18s ease; }
.api-link:hover { text-decoration-color: var(--accent); }

/* auth callout Ã¢â‚¬â€ a quiet well, set apart from the endpoint cards */
.api-note { display: flex; gap: 0.9rem; align-items: flex-start; margin-top: clamp(1.4rem, 2.5vw, 2rem); padding: clamp(0.95rem, 2vw, 1.25rem) clamp(1.1rem, 2.2vw, 1.4rem); background: var(--well); border: 1px solid var(--line); border-radius: var(--r-lg); }
.api-note-label { flex: none; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--accent-press); background: var(--card); border: 1px solid var(--line); padding: 0.22rem 0.55rem; border-radius: var(--r-sm); }
.api-note p { margin: 0.05rem 0 0; font-size: 0.92rem; color: var(--ink-2); max-width: 70ch; }

/* code blocks with a copy affordance */
.api-codewrap { position: relative; }
.api-code {
  margin: 0; background: var(--ink); color: oklch(0.91 0.012 80);
  font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.7;
