[Unit]
Description=Caddy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config /etc/caddy/caddy.real.json
Restart=always
User=root
Group=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
SupplementaryGroups=ssl-cert
EnvironmentFile=-/etc/farpy/nm-metrics.env

[Install]
WantedBy=multi-user.target

