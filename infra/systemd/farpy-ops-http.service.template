[Unit]
Description=Farpy Local Ops HTTP
After=network.target farpy-ops-snapshot.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/farpy/ops
ExecStart=/usr/bin/python3 -m http.server 19999 --bind 127.0.0.1 --directory /opt/farpy/ops
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

